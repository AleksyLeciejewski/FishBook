<div class="bg-white rounded-lg shadow-md p-6 mb-6">
    <h2 class="text-xl font-bold text-gray-800 mb-4">
        <i class="fas fa-cloud-sun text-blue-500 mr-2"></i>
        Weather in Copenhagen
    </h2>
    
    <% if (weather) { %>
        <div class="flex items-center justify-between mb-4">
            <div class="text-5xl font-bold text-gray-800">
                <%= Math.round(weather.temperature) %>°C
            </div>
            <div class="text-4xl">
                <% if (weather.condition === 'sunny') { %>
                    <i class="fas fa-sun text-yellow-400"></i>
                <% } else if (weather.condition === 'partly-cloudy') { %>
                    <i class="fas fa-cloud-sun text-gray-400"></i>
                <% } else if (weather.condition === 'cloudy') { %>
                    <i class="fas fa-cloud text-gray-400"></i>
                <% } else if (weather.condition === 'rainy') { %>
                    <i class="fas fa-cloud-rain text-blue-400"></i>
                <% } else if (weather.condition === 'stormy') { %>
                    <i class="fas fa-bolt text-yellow-500"></i>
                <% } else if (weather.condition === 'windy') { %>
                    <i class="fas fa-wind text-blue-300"></i>
                <% } else if (weather.condition === 'foggy') { %>
                    <i class="fas fa-smog text-gray-300"></i>
                <% } %>
            </div>
        </div>
        
        <div class="space-y-2 text-sm text-gray-600">
            <div class="flex justify-between">
                <span>Feels like</span>
                <span class="font-medium"><%= Math.round(weather.feelsLike) %>°C</span>
            </div>
            <div class="flex justify-between">
                <span>Humidity</span>
                <span class="font-medium"><%= weather.humidity %>%</span>
            </div>
            <div class="flex justify-between">
                <span>Wind</span>
                <span class="font-medium">
                    <%= weather.windSpeed %> km/h 
                    <i class="fas fa-arrow-up ml-1" style="transform: rotate(<%= weather.windDirection %>deg)"></i>
                </span>
            </div>
            <div class="flex justify-between">
                <span>Pressure</span>
                <span class="font-medium"><%= weather.pressure %> hPa</span>
            </div>
        </div>
        
        <div class="mt-4 pt-4 border-t border-gray-100">
            <p class="text-sm text-gray-500 text-center">
                Last updated: <%= new Date(weather.timestamp).toLocaleTimeString() %>
            </p>
        </div>
    <% } else { %>
        <div class="text-center py-4 text-gray-500">
            <i class="fas fa-cloud-sun text-4xl text-gray-300 mb-2"></i>
            <p>Weather data not available</p>
        </div>
    <% } %>
</div>
