<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - FishHub</title>
    <link rel="icon" type="image/png" href="/images/fishhub-logo.png">
    <link rel="shortcut icon" type="image/png" href="/images/fishhub-logo.png">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body class="bg-black min-h-screen flex items-center justify-center py-12 px-4">
    <div class="max-w-md w-full bg-gray-900 rounded-2xl shadow-2xl overflow-hidden border border-gray-700">
    <div class="bg-black px-6 py-8 text-center border-b border-yellow-400">
        <div class="mb-4">
            <img src="/images/fishhub-logo.png" alt="FishHub" class="h-16 mx-auto">
        </div>
        <h1 class="text-3xl font-bold text-white mb-2">Join FishHub</h1>
        <p class="text-gray-400">Start your fishing adventure today!</p>
    </div>
    <div class="px-8 py-8">
        
        <% if (errors && errors.length > 0) { %>
            <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6" role="alert">
                <div class="flex">
                    <div class="py-1">
                        <i class="fas fa-exclamation-circle text-red-500 mr-3"></i>
                    </div>
                    <div>
                        <% errors.forEach(error => { %>
                            <p class="text-sm"><%= error.msg %></p>
                        <% }); %>
                    </div>
                </div>
            </div>
        <% } %>
        
        <form action="/auth/register" method="POST" class="space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="firstName" class="block text-sm font-semibold text-white mb-2">
                        <i class="fas fa-user text-yellow-400 mr-2"></i>First Name
                    </label>
                    <input type="text" 
                           id="firstName" 
                           name="firstName" 
                           required
                           placeholder="John"
                           class="w-full px-4 py-3 border border-gray-700 bg-gray-800 text-white rounded-xl focus:ring-2 focus:ring-yellow-400 focus:border-yellow-400 transition"
                           value="<%= typeof firstName !== 'undefined' ? firstName : '' %>">
                </div>
                <div>
                    <label for="lastName" class="block text-sm font-semibold text-white mb-2">
                        <i class="fas fa-user text-yellow-400 mr-2"></i>Last Name
                    </label>
                    <input type="text" 
                           id="lastName" 
                           name="lastName" 
                           required
                           placeholder="Doe"
                           class="w-full px-4 py-3 border border-gray-700 bg-gray-800 text-white rounded-xl focus:ring-2 focus:ring-yellow-400 focus:border-yellow-400 transition"
                           value="<%= typeof lastName !== 'undefined' ? lastName : '' %>">
                </div>
            </div>
            
            <div>
                <label for="username" class="block text-sm font-semibold text-white mb-2">
                    <i class="fas fa-at text-yellow-400 mr-2"></i>Username
                </label>
                <input type="text" 
                       id="username" 
                       name="username" 
                       required
                       placeholder="fishmaster123"
                       class="w-full px-4 py-3 border border-gray-700 bg-gray-800 text-white rounded-xl focus:ring-2 focus:ring-yellow-400 focus:border-yellow-400 transition"
                       value="<%= typeof username !== 'undefined' ? username : '' %>">
            </div>
            
            <div>
                <label for="email" class="block text-sm font-semibold text-white mb-2">
                    <i class="fas fa-envelope text-yellow-400 mr-2"></i>Email Address
                </label>
                <input type="email" 
                       id="email" 
                       name="email" 
                       required
                       placeholder="your@email.com"
                       class="w-full px-4 py-3 border border-gray-700 bg-gray-800 text-white rounded-xl focus:ring-2 focus:ring-yellow-400 focus:border-yellow-400 transition"
                       value="<%= typeof email !== 'undefined' ? email : '' %>">
            </div>
            
            <div>
                <label for="password" class="block text-sm font-semibold text-white mb-2">
                    <i class="fas fa-lock text-yellow-400 mr-2"></i>Password
                </label>
                <input type="password" 
                       id="password" 
                       name="password" 
                       required
                       minlength="6"
                       placeholder="At least 6 characters"
                       class="w-full px-4 py-3 border border-gray-700 bg-gray-800 text-white rounded-xl focus:ring-2 focus:ring-yellow-400 focus:border-yellow-400 transition">
                <p class="mt-2 text-xs text-gray-400"><i class="fas fa-info-circle mr-1"></i>Must be at least 6 characters</p>
            </div>
            
            <div>
                <label for="confirmPassword" class="block text-sm font-semibold text-white mb-2">
                    <i class="fas fa-lock text-yellow-400 mr-2"></i>Confirm Password
                </label>
                <input type="password" 
                       id="confirmPassword" 
                       name="confirmPassword" 
                       required
                       minlength="6"
                       placeholder="Re-enter your password"
                       class="w-full px-4 py-3 border border-gray-700 bg-gray-800 text-white rounded-xl focus:ring-2 focus:ring-yellow-400 focus:border-yellow-400 transition">
            </div>
            
            <div class="flex items-start">
                <div class="flex items-center h-5">
                    <input type="checkbox" 
                           id="terms" 
                           name="terms" 
                           required
                           class="h-4 w-4 text-yellow-400 focus:ring-yellow-400 border-gray-700 rounded">
                </div>
                <div class="ml-3 text-sm">
                    <label for="terms" class="font-medium text-gray-300">I agree to the <a href="/terms" class="text-yellow-400 hover:underline">Terms of Service</a> and <a href="/privacy" class="text-yellow-400 hover:underline">Privacy Policy</a></label>
                </div>
            </div>
            
            <div class="pt-2">
                <button type="submit" 
                        class="w-full flex justify-center items-center py-4 px-4 border border-transparent rounded-xl shadow-lg text-base font-bold text-black bg-yellow-400 hover:bg-yellow-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-400 transition transform hover:scale-105">
                    <i class="fas fa-user-plus mr-2"></i> Create Account
                </button>
            </div>
        </form>
        
        <div class="mt-8">
            <div class="relative">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-gray-700"></div>
                </div>
                <div class="relative flex justify-center text-sm">
                    <span class="px-4 bg-gray-900 text-gray-400 font-medium">Or sign up with</span>
                </div>
            </div>
            
            <div class="mt-6 grid grid-cols-2 gap-4">
                <div>
                    <a href="/auth/google" class="w-full inline-flex justify-center items-center py-3 px-4 border border-gray-700 rounded-xl shadow-sm bg-gray-800 text-sm font-semibold text-white hover:bg-gray-700 transition transform hover:scale-105">
                        <i class="fab fa-google text-red-500 text-lg"></i>
                        <span class="ml-2">Google</span>
                    </a>
                </div>
                <div>
                    <a href="/auth/facebook" class="w-full inline-flex justify-center items-center py-3 px-4 border border-gray-700 rounded-xl shadow-sm bg-gray-800 text-sm font-semibold text-white hover:bg-gray-700 transition transform hover:scale-105">
                        <i class="fab fa-facebook text-blue-600 text-lg"></i>
                        <span class="ml-2">Facebook</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="bg-black px-8 py-5 border-t border-gray-700">
        <div class="text-sm text-center text-gray-400">
            Already have an account? 
            <a href="/auth/login" class="font-bold text-yellow-400 hover:text-yellow-300 transition">
                Sign in <i class="fas fa-arrow-right ml-1"></i>
            </a>
        </div>
    </div>
</div>
</body>
</html>
