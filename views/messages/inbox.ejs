<!-- views/message/inbox.html -->


<pre>
<%= JSON.stringify(conversations, null, 2) %>
</pre>

<%- include('../partials/header') %>


<div class="max-w-5xl mx-auto">
    <!-- Header -->
    <div class="bg-white rounded-xl shadow-md p-6 mb-6">
        <div class="flex items-center justify-between">
            <div class="flex items-center">
                <div class="w-12 h-12 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center mr-4">
                    <i class="fas fa-inbox text-white text-xl"></i>
                </div>
                <div>
                    <h1 class="text-3xl font-bold text-gray-800">Messages</h1>
                    <p class="text-gray-500 text-sm">Your conversations with other anglers</p>
                </div>
            </div>
            <a href="/" class="inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition">
                <i class="fas fa-arrow-left mr-2"></i> Back to Home
            </a>
        </div>
    </div>

    <!-- Conversations List -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
        <% if (conversations && conversations.length > 0) { %>
            <div class="divide-y divide-gray-100">
                <% conversations.forEach(conv => { %>
                    <a href="/messages/<%= conv.user._id %>" class="block hover:bg-blue-50 transition duration-200">
                        <div class="p-5 flex items-center space-x-4">
                            <!-- Avatar -->
                            <div class="flex-shrink-0">
                                <% if (conv.user.profilePicture) { %>
                                    <img src="<%= conv.user.profilePicture %>"
                                         alt="<%= conv.user.username %>"
                                         class="w-16 h-16 rounded-full object-cover border-3 border-blue-200 shadow-md">
                                <% } else { %>
                                    <div class="w-16 h-16 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center text-white font-bold text-2xl shadow-md border-3 border-blue-200">
                                        <%= conv.user.username.charAt(0).toUpperCase() %>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Message Info -->
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between mb-1">
                                    <h3 class="text-lg font-bold text-gray-800 truncate">
                                        <%= conv.user.username %>
                                    </h3>
                                    <span class="text-xs text-gray-400 ml-2 flex-shrink-0">
                                        <i class="far fa-clock mr-1"></i>
                                        <%= new Date(conv.lastMessageTime).toLocaleDateString('en-US', {
                                            month: 'short',
                                            day: 'numeric',
                                            hour: '2-digit',
                                            minute: '2-digit'
                                        }) %>
                                    </span>
                                </div>
                                <p class="text-gray-600 text-sm truncate">
                                    <%= conv.lastMessage.length > 80 ? conv.lastMessage.substring(0, 80) + '...' : conv.lastMessage %>
                                </p>
                            </div>

                            <!-- Arrow Icon -->
                            <div class="flex-shrink-0">
                                <i class="fas fa-chevron-right text-gray-400"></i>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>
        <% } else { %>
            <!-- Empty State -->
            <div class="text-center py-16 px-6">
                <div class="inline-flex items-center justify-center w-32 h-32 rounded-full bg-gradient-to-br from-blue-100 via-indigo-100 to-purple-100 mb-6 shadow-lg">
                    <i class="fas fa-comments text-6xl text-blue-600 animate-pulse"></i>
                </div>
                <h3 class="text-2xl font-bold text-gray-800 mb-3">No Messages Yet</h3>
                <p class="text-gray-600 mb-8 max-w-md mx-auto">
                    Start connecting with other anglers! Join a fishing trip to meet new people and start conversations.
                </p>
                <a href="/trips" class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-bold rounded-xl shadow-xl transition transform hover:scale-105">
                    <i class="fas fa-calendar-check mr-3 text-xl"></i> Browse Trips
                </a>
            </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>