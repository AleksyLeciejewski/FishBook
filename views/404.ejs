<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found - FishHub</title>
    <link rel="icon" type="image/png" href="/images/fishhub-logo.png">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black min-h-screen">
    <div class="container mx-auto px-4 py-8">
        <div class="max-w-3xl mx-auto bg-gray-900 rounded-lg shadow-md overflow-hidden border border-gray-700">
            <div class="bg-black px-6 py-4 border-b border-yellow-400">
                <h1 class="text-2xl font-bold text-white">404 - Page Not Found</h1>
            </div>
            <div class="p-6">
                <div class="bg-gray-800 border-l-4 border-yellow-400 text-gray-300 p-4 mb-6">
                    <p class="font-bold">The page you're looking for doesn't exist.</p>
                    <p class="mt-2">The requested URL was not found on this server.</p>
                </div>
                <div class="flex justify-center">
                    <div class="w-64 h-64 bg-gray-800 flex items-center justify-center rounded-full border-2 border-yellow-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-32 w-32 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                </div>
                <div class="mt-8 text-center">
                    <a href="/" class="inline-block bg-yellow-400 hover:bg-yellow-300 text-black font-bold py-2 px-6 rounded-lg transition duration-200">
                        Return to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
