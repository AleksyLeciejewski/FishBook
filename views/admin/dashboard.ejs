<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - <%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-table {
            font-size: 0.9rem;
            border-spacing: 0;
        }

        .admin-table th,
        .admin-table td {
            padding: 1rem 1.5rem;
        }

        .admin-table th {
            background-color: #f8f9fa;
            font-weight: 600;
        }

        .admin-table tbody tr:hover {
            background-color: #f8f9fa;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .admin-controls {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .search-input, .filter-select {
            padding: 0.5rem 1rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 0.9rem;
        }

        .search-input {
            min-width: 200px;
        }

        .table-container {
            overflow-x: auto;
        }

        .action-cell {
            white-space: nowrap;
            padding: 1rem !important;
        }

        .btn-small {
            margin: 0.25rem 0.5rem;
            padding: 0.6rem 1rem;
        }

        .btn-icon {
            font-size: 0.9em;
        }

        .stat-icon {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .stat-trend, .stat-detail {
            display: block;
            font-size: 0.85rem;
            color: #666;
            margin-top: 0.5rem;
        }

        .stat-trend.positive {
            color: #28a745;
        }

        .empty-state {
            text-align: center;
            padding: 3rem;
            color: #666;
        }

        .toast {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            padding: 1rem 1.5rem;
            border-radius: 4px;
            color: white;
            font-weight: 500;
            opacity: 0;
            transition: opacity 0.3s;
            z-index: 1000;
        }

        .toast.show {
            opacity: 1;
        }

        .toast.success {
            background-color: #28a745;
        }

        .toast.error {
            background-color: #dc3545;
        }

        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        .spinner {
            border: 4px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top: 4px solid white;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Modal Styles */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.7);
            z-index: 10000;
            justify-content: center;
            align-items: center;
            padding: 1rem;
        }

        .modal-overlay.show {
            display: flex;
        }

        .modal-content {
            background: white;
            border-radius: 8px;
            max-width: 800px;
            width: 100%;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        .modal-header {
            padding: 1.5rem;
            border-bottom: 1px solid #ddd;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h2 {
            margin: 0;
            font-size: 1.5rem;
        }

        .modal-close {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: #666;
            padding: 0;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-close:hover {
            color: #000;
        }

        .modal-body {
            padding: 1.5rem;
        }

        .list-item {
            padding: 1rem;
            border: 1px solid #e0e0e0;
            border-radius: 6px;
            margin-bottom: 1rem;
            background: #f9f9f9;
        }

        .list-item strong {
            display: block;
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
            color: #333;
        }

        .small-meta {
            font-size: 0.85rem;
            color: #666;
            margin-bottom: 0.5rem;
        }

        .list-item div:last-child {
            color: #555;
            line-height: 1.5;
        }

        @media (max-width: 768px) {
            .admin-controls {
                width: 100%;
            }

            .search-input, .filter-select {
                flex: 1;
                min-width: 0;
            }

            .admin-table {
                font-size: 0.85rem;
            }

            .btn-small .btn-icon {
                display: inline;
            }

            .btn-small {
                padding: 0.4rem 0.6rem;
            }

            .modal-content {
                max-height: 90vh;
            }

            .modal-header h2 {
                font-size: 1.2rem;
            }
        }
    </style>
</head>
<body>
<%- include('../partials/header') %>

<div class="admin-container">
    <h1>Admin Dashboard</h1>

    <!-- Enhanced Stats Section with Icons and Trends -->
    <div class="admin-stats">
        <div class="stat-card">
            <div class="stat-icon">👥</div>
            <h3>Total Users</h3>
            <p class="stat-number"><%= stats.totalUsers %></p>
            <% if (stats.newUsersThisWeek) { %>
                <span class="stat-trend positive">+<%= stats.newUsersThisWeek %> this week</span>
            <% } %>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🎣</div>
            <h3>Total Catches</h3>
            <p class="stat-number"><%= stats.totalCatches %></p>
            <% if (stats.avgCatchesPerUser) { %>
                <span class="stat-detail"><%= stats.avgCatchesPerUser.toFixed(1) %> per user</span>
            <% } %>
        </div>
        <div class="stat-card">
            <div class="stat-icon">🚤</div>
            <h3>Total Trips</h3>
            <p class="stat-number"><%= stats.totalTrips %></p>
            <% if (stats.activeTrips) { %>
                <span class="stat-detail"><%= stats.activeTrips %> active</span>
            <% } %>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="admin-section">
        <div class="section-header">
            <h2>User Management</h2>
            <div class="admin-controls">
                <input type="text" id="searchUsers" placeholder="Search users..." class="search-input">
                <select id="filterRole" class="filter-select">
                    <option value="">All Roles</option>
                    <option value="admin">Admin</option>
                    <option value="user">User</option>
                </select>
                <select id="filterVerified" class="filter-select">
                    <option value="">All Status</option>
                    <option value="verified">Verified</option>
                    <option value="unverified">Unverified</option>
                </select>
            </div>
        </div>

        <!-- Enhanced Table with Better Responsiveness -->
        <div class="table-container">
            <table class="admin-table">
                <thead>
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Verified</th>
                    <th>Joined</th>
                    <th class="text-center">Actions</th>
                </tr>
                </thead>
                <tbody id="usersTableBody">
                <% users.forEach(user => { %>
                    <tr data-user-id="<%= user._id %>"
                        data-role="<%= user.role %>"
                        data-verified="<%= user.isVerified ? 'verified' : 'unverified' %>">
                        <td>
                            <strong><%= user.username %></strong>
                        </td>
                        <td><%= user.email %></td>
                        <td>
                            <span class="badge badge-<%= user.role %>"><%= user.role %></span>
                        </td>
                        <td>
                            <span class="badge <%= user.isVerified ? 'badge-verified' : 'badge-unverified' %>">
                                <%= user.isVerified ? '✓ Verified' : '✗ Unverified' %>
                            </span>
                        </td>
                        <td>
                            <span class="date-text"><%= new Date(user.createdAt).toLocaleDateString() %></span>
                        </td>
                        <td class="action-cell">
                            <button class="btn-small btn-secondary"
                                    onclick="fetchUserCatches('<%= user._id %>', '<%= user.username %>')"
                                    title="View user's catches">
                                <span class="btn-icon">🎣</span> View Catches
                            </button>
                            <button class="btn-small btn-primary"
                                    onclick="toggleRole('<%= user._id %>', '<%= user.role %>')"
                                    title="Change role">
                                <span class="btn-icon">🔄</span> Toggle Role
                            </button>
                            <button class="btn-small <%= user.isVerified ? 'btn-warning' : 'btn-success' %>"
                                    onclick="toggleVerification('<%= user._id %>', <%= user.isVerified %>)"
                                    title="<%= user.isVerified ? 'Unverify' : 'Verify' %> user">
                                <span class="btn-icon"><%= user.isVerified ? '✗' : '✓' %></span>
                                <%= user.isVerified ? 'Unverify' : 'Verify' %>
                            </button>
                            <button class="btn-small btn-danger"
                                    onclick="deleteUser('<%= user._id %>', '<%= user.username %>')"
                                    title="Delete user">
                                <span class="btn-icon">🗑️</span> Delete
                            </button>
                        </td>
                    </tr>
                <% }); %>
                </tbody>
            </table>
        </div>

        <% if (users.length === 0) { %>
            <div class="empty-state">
                <p>No users found</p>
            </div>
        <% } %>
    </div>
</div>

<!-- Toast Notification -->
<div id="toast" class="toast"></div>

<!-- Loading Overlay -->
<div id="loadingOverlay" class="loading-overlay" style="display: none;">
    <div class="spinner"></div>
</div>

<!-- Modal for Viewing Catches -->
<div id="modalOverlay" class="modal-overlay" onclick="closeModalOnOverlay(event)">
    <div class="modal-content" onclick="event.stopPropagation()">
        <div class="modal-header">
            <h2 id="modalTitle">Modal Title</h2>
            <button class="modal-close" onclick="closeModal()" aria-label="Close modal">&times;</button>
        </div>
        <div class="modal-body" id="modalBody">
            Modal content goes here
        </div>
    </div>
</div>

<script>
    // Search and Filter Functionality
    const searchInput = document.getElementById('searchUsers');
    const roleFilter = document.getElementById('filterRole');
    const verifiedFilter = document.getElementById('filterVerified');
    const tableBody = document.getElementById('usersTableBody');

    function filterUsers() {
        const searchTerm = searchInput.value.toLowerCase();
        const roleValue = roleFilter.value;
        const verifiedValue = verifiedFilter.value;
        const rows = tableBody.getElementsByTagName('tr');

        Array.from(rows).forEach(row => {
            const username = row.querySelector('td:first-child')?.textContent.toLowerCase() || '';
            const email = row.querySelector('td:nth-child(2)')?.textContent.toLowerCase() || '';
            const role = row.dataset.role;
            const verified = row.dataset.verified;

            const matchesSearch = username.includes(searchTerm) || email.includes(searchTerm);
            const matchesRole = !roleValue || role === roleValue;
            const matchesVerified = !verifiedValue || verified === verifiedValue;

            row.style.display = matchesSearch && matchesRole && matchesVerified ? '' : 'none';
        });
    }

    searchInput?.addEventListener('input', filterUsers);
    roleFilter?.addEventListener('change', filterUsers);
    verifiedFilter?.addEventListener('change', filterUsers);

    // Toast Notification System
    function showToast(message, type = 'success') {
        const toast = document.getElementById('toast');
        toast.textContent = message;
        toast.className = `toast ${type} show`;
        setTimeout(() => {
            toast.classList.remove('show');
        }, 3000);
    }

    // Loading Overlay
    function showLoading() {
        document.getElementById('loadingOverlay').style.display = 'flex';
    }

    function hideLoading() {
        document.getElementById('loadingOverlay').style.display = 'none';
    }

    // Modal Functions
    function openModal(title, bodyHTML) {
        document.getElementById('modalTitle').textContent = title;
        document.getElementById('modalBody').innerHTML = bodyHTML;
        document.getElementById('modalOverlay').classList.add('show');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        document.getElementById('modalOverlay').classList.remove('show');
        document.body.style.overflow = '';
    }

    function closeModalOnOverlay(event) {
        if (event.target.id === 'modalOverlay') {
            closeModal();
        }
    }

    // Close modal on Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeModal();
        }
    });

    // HTML Escape Utility
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    // Fetch User Catches Function
    async function fetchUserCatches(userId, username) {
        openModal(`Catches by ${username}`, '<p>Loading catches...</p>');
        try {
            const res = await fetch(`/admin/users/${userId}/catches`);
            const json = await res.json();
            if (!res.ok) {
                openModal('Error', `<p>${json?.message || 'Failed to fetch catches'}</p>`);
                return;
            }
            const catches = json.catches || [];
            if (catches.length === 0) {
                openModal(`Catches by ${username}`, '<p>No catches found</p>');
                return;
            }
            const html = catches.map(c => {
                const created = c.date ? new Date(c.date).toLocaleString() : (c.createdAt ? new Date(c.createdAt).toLocaleString() : '—');
                const species = c.species || '(unknown)';
                const weight = c.weight ? `${c.weight} ${c.weightUnit || 'kg'}` : '';
                const location = c.location || c.spot || '—';
                const notes = (c.notes || c.description || '').substring(0, 500);
                // dummy Edit/Delete buttons added below
                return `<div class="list-item" data-catch-id="${escapeHtml(c._id || '')}">
                        <strong>${escapeHtml(species)} ${escapeHtml(weight)}</strong>
                        <div class="small-meta">Date: ${escapeHtml(created)} — Location: ${escapeHtml(location)}</div>
                        <div>${escapeHtml(notes)}</div>
                        <div style="margin-top:0.5rem; display:flex; gap:0.5rem;">
                            <button class="btn-small btn-secondary" onclick="editCatch('${escapeHtml(c._id || '')}')" title="Edit catch">✏️ Edit</button>
                            <button class="btn-small btn-danger" onclick="deleteCatch('${escapeHtml(c._id || '')}')" title="Delete catch">🗑️ Delete</button>
                        </div>
                    </div>`;
            }).join('');
            openModal(`Catches by ${username}`, html);
        } catch (err) {
            console.error(err);
            openModal('Error', '<p>Network error while fetching catches</p>');
        }
    }

    // Dummy handlers to make the buttons do something visible (non-functional)
    function editCatch(catchId) {
        // show a simple edit modal (dummy)
        openModal('Edit Catch', `<p>Dummy edit UI for catch <strong>${escapeHtml(catchId)}</strong></p>
                             <p>This is a placeholder — editing not implemented.</p>
                             <div style="margin-top:1rem;">
                                <button class="btn-small btn-primary" onclick="showToast('Save pressed (dummy)', 'success')">Save (dummy)</button>
                                <button class="btn-small btn-secondary" onclick="closeModal()">Close</button>
                             </div>`);
    }

    function deleteCatch(catchId) {
        if (!confirm('Delete this catch? This is a dummy action and will not remove anything.')) return;
        // pretend we deleted it
        showToast(`Catch ${catchId} deleted (dummy)`, 'success');
        // Optionally close modal or remove DOM node
        closeModal();
    }

    // Enhanced Toggle Role Function
    async function toggleRole(userId, currentRole) {
        const newRole = currentRole === 'admin' ? 'user' : 'admin';

        if (!confirm(`Change user role from ${currentRole} to ${newRole}?`)) return;

        showLoading();

        try {
            const res = await fetch(`/admin/users/${userId}/role`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ role: newRole })
            });

            hideLoading();

            if (res.ok) {
                showToast(`User role updated to ${newRole}`, 'success');
                setTimeout(() => location.reload(), 1000);
            } else {
                const error = await res.json();
                showToast(error.message || 'Failed to update role', 'error');
            }
        } catch (err) {
            hideLoading();
            console.error(err);
            showToast('Error updating role', 'error');
        }
    }

    // Toggle Verification Function
    async function toggleVerification(userId, isCurrentlyVerified) {
        const action = isCurrentlyVerified ? 'unverify' : 'verify';

        if (!confirm(`${action.charAt(0).toUpperCase() + action.slice(1)} this user?`)) return;

        showLoading();

        try {
            const res = await fetch(`/admin/users/${userId}/verify`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ isVerified: !isCurrentlyVerified })
            });

            hideLoading();

            if (res.ok) {
                showToast(`User ${action}ed successfully`, 'success');
                setTimeout(() => location.reload(), 1000);
            } else {
                const error = await res.json();
                showToast(error.message || `Failed to ${action} user`, 'error');
            }
        } catch (err) {
            hideLoading();
            console.error(err);
            showToast(`Error ${action}ing user`, 'error');
        }
    }

    // Enhanced Delete User Function
    async function deleteUser(userId, username) {
        if (!confirm(`Delete user "${username}"? This action cannot be undone.`)) return;

        // Double confirmation for safety
        if (!confirm('Are you absolutely sure? All user data will be permanently deleted.')) return;

        showLoading();

        try {
            const res = await fetch(`/admin/users/${userId}`, {
                method: 'DELETE'
            });

            hideLoading();

            if (res.ok) {
                showToast(`User "${username}" deleted successfully`, 'success');
                // Remove row with animation
                const row = document.querySelector(`tr[data-user-id="${userId}"]`);
                if (row) {
                    row.style.transition = 'opacity 0.3s';
                    row.style.opacity = '0';
                    setTimeout(() => row.remove(), 300);
                }
            } else {
                const error = await res.json();
                showToast(error.message || 'Failed to delete user', 'error');
            }
        } catch (err) {
            hideLoading();
            console.error(err);
            showToast('Error deleting user', 'error');
        }
    }

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
        // Focus search on Ctrl/Cmd + K
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
            e.preventDefault();
            searchInput?.focus();
        }
    });
</script>

<%- include('../partials/footer') %>
</body>
</html>