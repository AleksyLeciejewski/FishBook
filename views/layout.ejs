<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FishBook - <%= title || 'Social Network for Anglers' %></title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-100">
    <!-- Navigation -->
    <nav class="bg-blue-600 text-white shadow-lg">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <a href="/" class="text-2xl font-bold">FishBook</a>
            <div class="flex items-center space-x-4">
                <% if (locals.currentUser) { %>
                    <a href="/catches" class="hover:bg-blue-700 px-3 py-2 rounded">My Catches</a>
                    <a href="/trips" class="hover:bg-blue-700 px-3 py-2 rounded">Trips</a>
                    <a href="/fishing-spots" class="hover:bg-blue-700 px-3 py-2 rounded">Find Spots</a>
                    <div class="relative group">
                        <button class="flex items-center space-x-2 focus:outline-none">
                            <img src="<%= currentUser.profilePicture || '/images/default-avatar.png' %>" 
                                 alt="Profile" 
                                 class="w-8 h-8 rounded-full border-2 border-white">
                            <span><%= currentUser.username %></span>
                            <i class="fas fa-chevron-down text-xs"></i>
                        </button>
                        <div class="hidden group-hover:block absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-10">
                            <a href="/users/<%= currentUser._id %>" class="block px-4 py-2 text-gray-800 hover:bg-gray-100">
                                <i class="fas fa-user mr-2"></i>Profile
                            </a>
                            <a href="/settings" class="block px-4 py-2 text-gray-800 hover:bg-gray-100">
                                <i class="fas fa-cog mr-2"></i>Settings
                            </a>
                            <form action="/auth/logout" method="POST" class="border-t border-gray-200 mt-1">
                                <button type="submit" class="w-full text-left px-4 py-2 text-gray-800 hover:bg-gray-100">
                                    <i class="fas fa-sign-out-alt mr-2"></i>Logout
                                </button>
                            </form>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/auth/register" class="hover:bg-blue-700 px-3 py-2 rounded">Register</a>
                    <a href="/auth/login" class="bg-white text-blue-600 hover:bg-gray-200 px-4 py-2 rounded font-medium">Login</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Flash Messages -->
    <% if (messages && messages.length > 0) { %>
        <div class="container mx-auto px-4 mt-4">
            <% messages.forEach(message => { %>
                <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
                    <span class="block sm:inline"><%= message %></span>
                </div>
            <% }); %>
        </div>
    <% } %>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-6">
        <%- body %>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white py-6 mt-12">
        <div class="container mx-auto px-4">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="mb-4 md:mb-0">
                    <h2 class="text-xl font-bold">FishBook</h2>
                    <p class="text-gray-400">Connect with fellow anglers and share your catches</p>
                </div>
                <div class="flex space-x-6">
                    <a href="/about" class="hover:text-blue-400">About</a>
                    <a href="/privacy" class="hover:text-blue-400">Privacy</a>
                    <a href="/terms" class="hover:text-blue-400">Terms</a>
                    <a href="/contact" class="hover:text-blue-400">Contact</a>
                </div>
            </div>
            <div class="border-t border-gray-700 mt-6 pt-6 text-center text-gray-400 text-sm">
                &copy; <%= new Date().getFullYear() %> FishBook. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
