<%- include('../partials/header') %>

<div class="max-w-4xl mx-auto">
    <!-- Chat Header -->
    <div class="bg-white rounded-xl shadow-md p-4 mb-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
                <a href="/messages" class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 transition">
                    <i class="fas fa-arrow-left"></i>
                </a>

                <% if (otherUser.profilePicture) { %>
                    <img src="<%= otherUser.profilePicture %>"
                         alt="<%= otherUser.username %>"
                         class="w-12 h-12 rounded-full object-cover border-2 border-blue-200 shadow-md">
                <% } else { %>
                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-blue-500 to-indigo-500 flex items-center justify-center text-white font-bold text-xl shadow-md">
                        <%= otherUser.username.charAt(0).toUpperCase() %>
                    </div>
                <% } %>

                <div>
                    <h2 class="text-xl font-bold text-gray-800"><%= otherUser.username %></h2>
                    <p class="text-sm text-gray-500">
                        <i class="fas fa-circle text-green-500 text-xs mr-1"></i>
                        Active
                    </p>
                </div>
            </div>

            <a href="/users/<%= otherUser._id %>" class="inline-flex items-center px-4 py-2 bg-blue-100 hover:bg-blue-200 text-blue-700 font-medium rounded-lg transition">
                <i class="fas fa-user mr-2"></i> View Profile
            </a>
        </div>
    </div>

    <!-- Messages Container -->
    <div class="bg-white rounded-xl shadow-md overflow-hidden" style="height: calc(100vh - 320px); min-height: 500px;">
        <div id="messages-container" class="h-full overflow-y-auto p-6 space-y-4" style="scroll-behavior: smooth;">
            <% if (messages && messages.length > 0) { %>
                <% messages.forEach(msg => { %>
                    <% const isSent = msg.sender._id.toString() === currentUserId.toString(); %>

                    <div class="flex <%= isSent ? 'justify-end' : 'justify-start' %> animate-fadeIn">
                        <div class="flex items-end space-x-2 max-w-md <%= isSent ? 'flex-row-reverse space-x-reverse' : '' %>">
                            <!-- Avatar (only for received messages) -->
                            <% if (!isSent) { %>
                                <% if (msg.sender.profilePicture) { %>
                                    <img src="<%= msg.sender.profilePicture %>"
                                         alt="<%= msg.sender.username %>"
                                         class="w-8 h-8 rounded-full object-cover flex-shrink-0">
                                <% } else { %>
                                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-gray-400 to-gray-500 flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
                                        <%= msg.sender.username.charAt(0).toUpperCase() %>
                                    </div>
                                <% } %>
                            <% } %>

                            <!-- Message Bubble -->
                            <div>
                                <div class="<%= isSent ? 'bg-gradient-to-r from-blue-500 to-indigo-500 text-white' : 'bg-gray-100 text-gray-800' %> rounded-2xl px-4 py-3 shadow-sm">
                                    <p class="text-sm whitespace-pre-wrap break-words"><%- msg.content.replace(/</g, '&lt;').replace(/>/g, '&gt;') %></p>
                                </div>
                                <p class="text-xs text-gray-400 mt-1 <%= isSent ? 'text-right' : 'text-left' %>">
                                    <%= new Date(msg.createdAt).toLocaleString('en-US', {
                                        month: 'short',
                                        day: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    }) %>
                                </p>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <!-- Empty Conversation -->
                <div class="flex items-center justify-center h-full">
                    <div class="text-center">
                        <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-gradient-to-br from-blue-100 to-indigo-100 mb-4">
                            <i class="fas fa-comments text-4xl text-blue-600"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-800 mb-2">Start the Conversation</h3>
                        <p class="text-gray-600">Send your first message to <%= otherUser.username %>!</p>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Message Input Form -->
    <div class="bg-white rounded-xl shadow-md p-4 mt-4">
        <form action="/messages/send" method="POST" class="flex items-end space-x-3">
            <input type="hidden" name="receiverId" value="<%= otherUser._id %>">

            <!-- Textarea -->
            <div class="flex-1">
                <textarea
                        name="content"
                        id="messageInput"
                        maxlength="2000"
                        rows="1"
                        required
                        placeholder="Type your message..."
                        class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-blue-500 focus:ring-2 focus:ring-blue-200 transition resize-none"
                        style="min-height: 50px; max-height: 150px;"
                ></textarea>
                <p class="text-xs text-gray-400 mt-1">
                    <span id="charCount">0</span> / 2000 characters
                </p>
            </div>

            <!-- Send Button -->
            <button
                    type="submit"
                    class="inline-flex items-center justify-center w-12 h-12 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white rounded-xl shadow-md transition transform hover:scale-105 flex-shrink-0"
                    title="Send message">
                <i class="fas fa-paper-plane text-lg"></i>
            </button>
        </form>
    </div>
</div>

<style>
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fadeIn {
        animation: fadeIn 0.3s ease-out;
    }

    #messages-container::-webkit-scrollbar {
        width: 8px;
    }

    #messages-container::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    #messages-container::-webkit-scrollbar-thumb {
        background: #cbd5e0;
        border-radius: 10px;
    }

    #messages-container::-webkit-scrollbar-thumb:hover {
        background: #a0aec0;
    }
</style>

<script>
    // Auto-scroll to bottom on page load
    const messagesContainer = document.getElementById('messages-container');
    messagesContainer.scrollTop = messagesContainer.scrollHeight;

    // Auto-resize textarea
    const textarea = document.getElementById('messageInput');
    const charCount = document.getElementById('charCount');

    textarea.addEventListener('input', function() {
        // Update character count
        charCount.textContent = this.value.length;

        // Auto-resize
        this.style.height = 'auto';
        this.style.height = Math.min(this.scrollHeight, 150) + 'px';
    });

    // Submit with Enter (Shift+Enter for new line)
    textarea.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            if (this.value.trim().length > 0) {
                this.closest('form').submit();
            }
        }
    });

    // Focus on textarea when page loads
    textarea.focus();
</script>

<%- include('../partials/footer') %>