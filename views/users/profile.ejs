<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - FishHub</title>
    <link rel="icon" type="image/png" href="/images/fishhub-logo.png">
    <link rel="shortcut icon" type="image/png" href="/images/fishhub-logo.png">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .stat-card {
            transition: all 0.3s ease;
        }
        .stat-card:hover {
            transform: translateY(-8px) scale(1.05);
        }
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }
        .float-animation {
            animation: float 3s ease-in-out infinite;
        }
        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 20px rgba(250, 204, 21, 0.5); }
            50% { box-shadow: 0 0 40px rgba(250, 204, 21, 0.8); }
        }
        .pulse-glow {
            animation: pulse-glow 2s ease-in-out infinite;
        }
    </style>
</head>
<body class="bg-black min-h-screen">
    <!-- Navigation -->
    <nav class="bg-black text-white shadow-lg sticky top-0 z-50 border-b border-yellow-400">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <a href="/" class="flex items-center">
                <img src="/images/fishhub-logo.png" alt="FishHub" class="h-10">
            </a>
            <div class="flex items-center space-x-4">
                <% if (locals.currentUser) { %>
                    <a href="/catches" class="hover:bg-gray-800 px-3 py-2 rounded transition text-white">My Catches</a>
                    <a href="/trips" class="hover:bg-gray-800 px-3 py-2 rounded transition text-white">Trips</a>
                    <a href="/fishing-spots" class="hover:bg-gray-800 px-3 py-2 rounded transition text-white">Find Spots</a>
                    <div class="relative">
                        <button id="userMenuButton" class="flex items-center space-x-2 hover:bg-gray-800 px-3 py-2 rounded transition focus:outline-none">
                            <img src="<%= currentUser.profilePicture || '/images/default-avatar.png' %>" 
                                 alt="Profile" 
                                 class="w-8 h-8 rounded-full border-2 border-yellow-400">
                            <span><%= currentUser.username %></span>
                            <i class="fas fa-chevron-down text-xs"></i>
                        </button>
                        <div id="userMenuDropdown" class="hidden absolute right-0 mt-2 w-48 bg-gray-900 rounded-lg shadow-xl py-2 z-10 border border-gray-700">
                            <a href="/users/<%= currentUser.id || currentUser._id %>" class="block px-4 py-2 text-white hover:bg-gray-800 transition">
                                <i class="fas fa-user mr-2 text-yellow-400"></i>My Profile
                            </a>
                            <a href="/settings" class="block px-4 py-2 text-white hover:bg-gray-800 transition">
                                <i class="fas fa-cog mr-2 text-yellow-400"></i>Settings
                            </a>
                            <form action="/auth/logout" method="POST" class="border-t border-gray-700 mt-1 pt-1">
                                <button type="submit" class="w-full text-left px-4 py-2 text-white hover:bg-gray-800 transition">
                                    <i class="fas fa-sign-out-alt mr-2 text-red-500"></i>Logout
                                </button>
                            </form>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/auth/register" class="hover:bg-gray-800 px-3 py-2 rounded transition text-white">Register</a>
                    <a href="/auth/login" class="bg-yellow-400 text-black hover:bg-yellow-300 px-4 py-2 rounded font-bold transition">Login</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Profile Header -->
    <div class="relative bg-gray-900 h-64 overflow-hidden border-b border-gray-700">
        <div class="absolute inset-0 opacity-20">
            <div class="absolute top-10 left-10 float-animation">
                <i class="fas fa-fish text-yellow-400 text-6xl opacity-20"></i>
            </div>
            <div class="absolute top-20 right-20 float-animation" style="animation-delay: 1s;">
                <i class="fas fa-fish text-yellow-400 text-4xl opacity-20"></i>
            </div>
            <div class="absolute bottom-10 left-1/3 float-animation" style="animation-delay: 2s;">
                <i class="fas fa-fish text-yellow-400 text-5xl opacity-20"></i>
            </div>
        </div>
    </div>

    <!-- Profile Content -->
    <div class="container mx-auto px-4 -mt-32 relative z-10">
        <div class="bg-gray-800 rounded-2xl shadow-2xl overflow-hidden mb-8 border border-gray-700">
            <div class="p-8">
                <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
                    <!-- Profile Picture -->
                    <div class="relative">
                        <div class="w-40 h-40 rounded-full border-8 border-yellow-400 shadow-2xl overflow-hidden pulse-glow">
                            <img src="<%= profileUser.profilePicture || '/images/default-avatar.png' %>" 
                                 alt="<%= profileUser.username %>" 
                                 class="w-full h-full object-cover">
                        </div>
                        <div class="absolute -bottom-2 -right-2 bg-gradient-to-r from-green-500 to-teal-500 text-white rounded-full p-3 shadow-lg">
                            <i class="fas fa-trophy text-2xl"></i>
                        </div>
                    </div>

                    <!-- Profile Info -->
                    <div class="flex-1 text-center md:text-left">
                        <h1 class="text-4xl font-bold text-white mb-2"><%= profileUser.username %></h1>
                        <p class="text-gray-300 mb-4"><%= profileUser.firstName %> <%= profileUser.lastName %></p>
                        
                        <% if (profileUser.bio) { %>
                            <p class="text-gray-300 mb-4 max-w-2xl"><%= profileUser.bio %></p>
                        <% } %>
                        
                        <div class="flex flex-wrap gap-4 justify-center md:justify-start mb-6">
                            <% if (profileUser.location) { %>
                                <span class="inline-flex items-center px-4 py-2 bg-gray-800 border border-yellow-400 text-yellow-400 rounded-full font-semibold">
                                    <i class="fas fa-map-marker-alt mr-2"></i><%= profileUser.location %>
                                </span>
                            <% } %>
                            <span class="inline-flex items-center px-4 py-2 bg-gray-800 border border-purple-400 text-purple-400 rounded-full font-semibold">
                                <i class="fas fa-calendar-alt mr-2"></i>Joined <%= new Date(profileUser.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %>
                            </span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex gap-4 justify-center md:justify-start">
                            <% if (locals.currentUser && (currentUser.id || currentUser._id) && (currentUser.id === profileUser._id.toString() || (currentUser._id && currentUser._id.toString() === profileUser._id.toString()))) { %>
                                <a href="/settings" class="inline-flex items-center px-6 py-3 bg-yellow-400 hover:bg-yellow-300 text-black font-bold rounded-xl shadow-lg transition transform hover:scale-105">
                                    <i class="fas fa-edit mr-2"></i> Edit Profile
                                </a>
                            <% } else if (locals.currentUser && locals.currentUser._id) { %>
                                <button class="inline-flex items-center px-6 py-3 bg-yellow-400 hover:bg-yellow-300 text-black font-bold rounded-xl shadow-lg transition transform hover:scale-105">
                                    <i class="fas fa-user-plus mr-2"></i> Follow
                                </button>
                            <% } %>
                        </div>
                    </div>

                    <!-- Social Stats -->
                    <div class="flex gap-6 md:gap-4 md:flex-col">
                        <div class="text-center">
                            <div class="text-3xl font-bold text-yellow-400"><%= stats.followers %></div>
                            <div class="text-sm text-gray-400 font-semibold">Followers</div>
                        </div>
                        <div class="text-center">
                            <div class="text-3xl font-bold text-purple-400"><%= stats.following %></div>
                            <div class="text-sm text-gray-400 font-semibold">Following</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fishing Stats -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <!-- Total Catches -->
            <div class="stat-card bg-gradient-to-br from-blue-500 to-indigo-600 rounded-2xl p-6 text-white shadow-xl">
                <div class="flex items-center justify-between mb-4">
                    <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-sm">
                        <i class="fas fa-fish text-4xl"></i>
                    </div>
                    <div class="text-right">
                        <div class="text-4xl font-extrabold"><%= stats.totalCatches %></div>
                        <div class="text-blue-100 font-semibold">Total Catches</div>
                    </div>
                </div>
                <div class="h-2 bg-white/20 rounded-full overflow-hidden">
                    <div class="h-full bg-white rounded-full" style="width: <%= Math.min(stats.totalCatches * 2, 100) %>%"></div>
                </div>
            </div>

            <!-- Total Weight -->
            <div class="stat-card bg-gradient-to-br from-green-500 to-teal-600 rounded-2xl p-6 text-white shadow-xl">
                <div class="flex items-center justify-between mb-4">
                    <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-sm">
                        <i class="fas fa-weight-hanging text-4xl"></i>
                    </div>
                    <div class="text-right">
                        <div class="text-4xl font-extrabold"><%= stats.totalWeight %></div>
                        <div class="text-green-100 font-semibold">Total KG</div>
                    </div>
                </div>
                <div class="h-2 bg-white/20 rounded-full overflow-hidden">
                    <div class="h-full bg-white rounded-full" style="width: <%= Math.min(stats.totalWeight * 1.5, 100) %>%"></div>
                </div>
            </div>

            <!-- Biggest Catch -->
            <div class="stat-card bg-gradient-to-br from-purple-500 to-pink-600 rounded-2xl p-6 text-white shadow-xl">
                <div class="flex items-center justify-between mb-4">
                    <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-sm">
                        <i class="fas fa-trophy text-4xl"></i>
                    </div>
                    <div class="text-right">
                        <div class="text-4xl font-extrabold"><%= stats.biggestCatch ? stats.biggestCatch.weight : 0 %></div>
                        <div class="text-purple-100 font-semibold">Biggest (KG)</div>
                    </div>
                </div>
                <% if (stats.biggestCatch) { %>
                    <div class="text-sm text-white/80 truncate"><%= stats.biggestCatch.species %></div>
                <% } else { %>
                    <div class="text-sm text-white/80">No catches yet</div>
                <% } %>
            </div>

            <!-- Species Diversity -->
            <div class="stat-card bg-gradient-to-br from-orange-500 to-red-600 rounded-2xl p-6 text-white shadow-xl">
                <div class="flex items-center justify-between mb-4">
                    <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-sm">
                        <i class="fas fa-layer-group text-4xl"></i>
                    </div>
                    <div class="text-right">
                        <div class="text-4xl font-extrabold"><%= stats.speciesCount %></div>
                        <div class="text-orange-100 font-semibold">Species</div>
                    </div>
                </div>
                <div class="h-2 bg-white/20 rounded-full overflow-hidden">
                    <div class="h-full bg-white rounded-full" style="width: <%= Math.min(stats.speciesCount * 10, 100) %>%"></div>
                </div>
            </div>
        </div>

        <!-- Recent Catches -->
        <div class="bg-gray-900 rounded-2xl shadow-xl p-8 mb-8 border border-gray-700">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-3xl font-bold text-white">
                    <i class="fas fa-fish text-yellow-400 mr-3"></i>Recent Catches
                </h2>
                <a href="/catches?userId=<%= profileUser._id %>" class="inline-flex items-center px-4 py-2 bg-yellow-400 hover:bg-yellow-300 text-black font-semibold rounded-lg transition transform hover:scale-105">
                    View All <i class="fas fa-arrow-right ml-2"></i>
                </a>
            </div>

            <% if (catches && catches.length > 0) { %>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% catches.forEach(catchItem => { %>
                        <a href="/catches/<%= catchItem._id %>" class="group block bg-gray-800 border-2 border-gray-700 rounded-2xl overflow-hidden hover:shadow-2xl hover:border-yellow-400 transition-all duration-300">
                            <div class="relative h-48 bg-gradient-to-br from-blue-400 via-indigo-500 to-purple-500 overflow-hidden">
                                <% if (catchItem.image) { %>
                                    <img src="/<%= catchItem.image %>" 
                                         alt="<%= catchItem.species %>" 
                                         class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                                <% } else { %>
                                    <div class="flex items-center justify-center h-full">
                                        <i class="fas fa-fish text-white text-6xl opacity-40"></i>
                                    </div>
                                <% } %>
                            </div>
                            <div class="p-4">
                                <h3 class="font-bold text-lg text-white mb-2"><%= catchItem.species %></h3>
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-yellow-400 font-semibold">
                                        <i class="fas fa-weight-hanging mr-1"></i><%= catchItem.weight %> kg
                                    </span>
                                    <span class="text-gray-400">
                                        <%= new Date(catchItem.dateCaught).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                    </span>
                                </div>
                            </div>
                        </a>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="text-center py-16">
                    <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-gray-800 border-2 border-yellow-400 mb-4">
                        <i class="fas fa-fish text-4xl text-yellow-400"></i>
                    </div>
                    <p class="text-gray-400 text-lg">No catches yet</p>
                </div>
            <% } %>
        </div>

        <!-- Recent Trips -->
        <% if (trips && trips.length > 0) { %>
            <div class="bg-gray-900 rounded-2xl shadow-xl p-8 mb-8 border border-gray-700">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-3xl font-bold text-white">
                        <i class="fas fa-calendar-check text-yellow-400 mr-3"></i>Recent Trips
                    </h2>
                    <a href="/trips?userId=<%= profileUser._id %>" class="inline-flex items-center px-4 py-2 bg-yellow-400 hover:bg-yellow-300 text-black font-semibold rounded-lg transition transform hover:scale-105">
                        View All <i class="fas fa-arrow-right ml-2"></i>
                    </a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <% trips.forEach(trip => { %>
                        <a href="/trips/<%= trip._id %>" class="block bg-gray-800 border-2 border-gray-700 rounded-xl p-6 hover:shadow-xl hover:border-yellow-400 transition-all duration-300">
                            <h3 class="font-bold text-xl text-white mb-2"><%= trip.title %></h3>
                            <div class="flex items-center gap-4 text-sm text-gray-300 mb-3">
                                <span><i class="fas fa-calendar mr-1 text-yellow-400"></i><%= new Date(trip.startDate).toLocaleDateString() %></span>
                                <span><i class="fas fa-map-marker-alt mr-1 text-yellow-400"></i><%= trip.locationName %></span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-sm text-gray-300">
                                    <i class="fas fa-users mr-1"></i><%= trip.participants.length %> / <%= trip.maxParticipants %> participants
                                </span>
                                <span class="px-3 py-1 bg-yellow-400 text-black text-xs font-bold rounded-full">
                                    <%= trip.isPublic ? 'Public' : 'Private' %>
                                </span>
                            </div>
                        </a>
                    <% }); %>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Footer -->
    <footer class="bg-black border-t border-gray-800 mt-12">
        <div class="container mx-auto px-4 py-8">
            <div class="text-center text-gray-400">
                <p class="text-sm">
                    &copy; <%= new Date().getFullYear() %> FishHub. Made with <i class="fas fa-heart text-yellow-400"></i> by anglers, for anglers.
                </p>
            </div>
        </div>
    </footer>
    
    <script>
        // User menu dropdown toggle
        document.addEventListener('DOMContentLoaded', function() {
            const menuButton = document.getElementById('userMenuButton');
            const menuDropdown = document.getElementById('userMenuDropdown');
            
            if (menuButton && menuDropdown) {
                menuButton.addEventListener('click', function(e) {
                    e.stopPropagation();
                    menuDropdown.classList.toggle('hidden');
                });
                
                // Close dropdown when clicking outside
                document.addEventListener('click', function(e) {
                    if (!menuButton.contains(e.target) && !menuDropdown.contains(e.target)) {
                        menuDropdown.classList.add('hidden');
                    }
                });
            }
        });
    </script>
</body>
</html>
