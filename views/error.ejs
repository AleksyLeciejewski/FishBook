<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error - FishHub</title>
    <link rel="icon" type="image/png" href="/images/fishhub-logo.png">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black min-h-screen">
    <div class="container mx-auto px-4 py-8">
        <div class="max-w-3xl mx-auto bg-gray-900 rounded-lg shadow-md overflow-hidden border border-gray-700">
            <div class="bg-black px-6 py-4 border-b border-red-500">
                <h1 class="text-2xl font-bold text-white">Error</h1>
            </div>
            <div class="p-6">
                <div class="bg-gray-800 border-l-4 border-red-500 text-red-300 p-4 mb-6">
                    <p class="font-bold"><%= error %></p>
                    <% if (typeof message !== 'undefined') { %>
                        <p class="mt-2"><%= message %></p>
                    <% } %>
                </div>
                <p class="mb-4 text-gray-300">An error occurred while processing your request. Please try again later.</p>
                <a href="/" class="inline-block bg-yellow-400 hover:bg-yellow-300 text-black font-bold py-2 px-4 rounded">
                    Return to Home
                </a>
            </div>
        </div>
    </div>
</body>
</html>
