<div class="max-w-3xl mx-auto bg-white rounded-lg shadow-md overflow-hidden">
    <div class="px-6 py-8">
        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-gray-800">Log Your Catch</h1>
            <p class="text-gray-600">Share your fishing success with the community</p>
        </div>
        
        <% if (errors && errors.length > 0) { %>
            <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6" role="alert">
                <div class="flex">
                    <div class="py-1">
                        <i class="fas fa-exclamation-circle text-red-500 mr-3"></i>
                    </div>
                    <div>
                        <% errors.forEach(error => { %>
                            <p class="text-sm"><%= error.msg %></p>
                        <% }); %>
                    </div>
                </div>
            </div>
        <% } %>
        
        <form action="/catches" method="POST" enctype="multipart/form-data" class="space-y-6">
            <!-- Species -->
            <div>
                <label for="species" class="block text-sm font-medium text-gray-700 mb-1">
                    Species <span class="text-red-500">*</span>
                </label>
                <input type="text" 
                       id="species" 
                       name="species" 
                       required
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                       placeholder="e.g., Largemouth Bass, Rainbow Trout"
                       value="<%= typeof catchItem !== 'undefined' ? catchItem.species : '' %>">
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Weight -->
                <div>
                    <label for="weight" class="block text-sm font-medium text-gray-700 mb-1">
                        Weight (kg) <span class="text-red-500">*</span>
                    </label>
                    <div class="relative rounded-md shadow-sm">
                        <input type="number" 
                               id="weight" 
                               name="weight" 
                               step="0.01"
                               min="0.01"
                               required
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="0.00"
                               value="<%= typeof catchItem !== 'undefined' ? catchItem.weight : '' %>">
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                            <span class="text-gray-500 sm:text-sm">kg</span>
                        </div>
                    </div>
                </div>
                
                <!-- Length -->
                <div>
                    <label for="length" class="block text-sm font-medium text-gray-700 mb-1">
                        Length (cm) <span class="text-gray-500 text-xs">(optional)</span>
                    </label>
                    <div class="relative rounded-md shadow-sm">
                        <input type="number" 
                               id="length" 
                               name="length" 
                               step="0.1"
                               min="1"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="0.0"
                               value="<%= typeof catchItem !== 'undefined' && catchItem.length ? catchItem.length : '' %>">
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                            <span class="text-gray-500 sm:text-sm">cm</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Catch Photo -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Catch Photo <span class="text-red-500">*</span>
                </label>
                <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-lg">
                    <div class="space-y-1 text-center" id="dropZone">
                        <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
                            <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <div class="flex text-sm text-gray-600">
                            <label for="image" class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-blue-500">
                                <span>Upload a file</span>
                                <input id="image" name="image" type="file" class="sr-only" accept="image/*" required>
                            </label>
                            <p class="pl-1">or drag and drop</p>
                        </div>
                        <p class="text-xs text-gray-500">
                            PNG, JPG, GIF up to 5MB
                        </p>
                        <div id="imagePreview" class="mt-2 hidden">
                            <img id="preview" src="#" alt="Preview" class="max-h-48 mx-auto rounded-lg">
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Location -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Location <span class="text-red-500">*</span>
                </label>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <input type="text" 
                               id="locationName" 
                               name="locationName" 
                               required
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                               placeholder="Lake, River, or Spot Name"
                               value="<%= typeof catchItem !== 'undefined' && catchItem.location ? catchItem.location.name : '' %>">
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <input type="number" 
                                   id="latitude" 
                                   name="latitude" 
                                   step="0.000001"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   placeholder="Latitude"
                                   value="<%= typeof catchItem !== 'undefined' && catchItem.location ? catchItem.location.coordinates[1] : '' %>">
                        </div>
                        <div>
                            <input type="number" 
                                   id="longitude" 
                                   name="longitude" 
                                   step="0.000001"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   placeholder="Longitude"
                                   value="<%= typeof catchItem !== 'undefined' && catchItem.location ? catchItem.location.coordinates[0] : '' %>">
                        </div>
                    </div>
                </div>
                <div class="mt-2">
                    <button type="button" id="getLocationBtn" class="text-sm text-blue-600 hover:text-blue-500">
                        <i class="fas fa-location-arrow mr-1"></i> Use my current location
                    </button>
                    <p class="text-xs text-gray-500 mt-1">
                        Or click on the map to select a location
                    </p>
                </div>
                <div id="map" class="mt-2 h-48 w-full bg-gray-100 rounded-lg overflow-hidden"></div>
            </div>
            
            <!-- Date and Time -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="dateCaught" class="block text-sm font-medium text-gray-700 mb-1">
                        Date Caught <span class="text-red-500">*</span>
                    </label>
                    <input type="date" 
                           id="dateCaught" 
                           name="dateCaught" 
                           required
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           value="<%= typeof catchItem !== 'undefined' ? new Date(catchItem.dateCaught).toISOString().split('T')[0] : new Date().toISOString().split('T')[0] %>">
                </div>
                <div>
                    <label for="timeCaught" class="block text-sm font-medium text-gray-700 mb-1">
                        Time Caught <span class="text-gray-500 text-xs">(optional)</span>
                    </label>
                    <input type="time" 
                           id="timeCaught" 
                           name="timeCaught" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           value="<%= typeof catchItem !== 'undefined' ? new Date(catchItem.dateCaught).toTimeString().substring(0, 5) : '' %>">
                </div>
            </div>
            
            <!-- Bait and Tackle -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label for="bait" class="block text-sm font-medium text-gray-700 mb-1">
                        Bait/Lure Used <span class="text-gray-500 text-xs">(optional)</span>
                    </label>
                    <input type="text" 
                           id="bait" 
                           name="bait" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="e.g., Worms, Crankbait, etc."
                           value="<%= typeof catchItem !== 'undefined' && catchItem.bait ? catchItem.bait : '' %>">
                </div>
                <div>
                    <label for="tackle" class="block text-sm font-medium text-gray-700 mb-1">
                        Tackle/Equipment <span class="text-gray-500 text-xs">(optional)</span>
                    </label>
                    <input type="text" 
                           id="tackle" 
                           name="tackle" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                           placeholder="e.g., Spinning Rod, 10lb Line"
                           value="<%= typeof catchItem !== 'undefined' && catchItem.tackle ? catchItem.tackle : '' %>">
                </div>
            </div>
            
            <!-- Weather Conditions -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Weather Conditions <span class="text-gray-500 text-xs">(optional)</span>
                </label>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                    <div>
                        <label for="weatherTemp" class="block text-xs text-gray-500 mb-1">Temperature (°C)</label>
                        <div class="relative rounded-md shadow-sm">
                            <input type="number" 
                                   id="weatherTemp" 
                                   name="weatherTemp" 
                                   step="0.1"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   placeholder="e.g., 22.5"
                                   value="<%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.temperature ? catchItem.weather.temperature : '' %>">
                        </div>
                    </div>
                    <div>
                        <label for="weatherCondition" class="block text-xs text-gray-500 mb-1">Condition</label>
                        <select id="weatherCondition" 
                                name="weatherCondition"
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">Select condition</option>
                            <option value="sunny" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.condition === 'sunny' ? 'selected' : '' %>>Sunny</option>
                            <option value="partly-cloudy" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.condition === 'partly-cloudy' ? 'selected' : '' %>>Partly Cloudy</option>
                            <option value="cloudy" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.condition === 'cloudy' ? 'selected' : '' %>>Cloudy</option>
                            <option value="rainy" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.condition === 'rainy' ? 'selected' : '' %>>Rainy</option>
                            <option value="stormy" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.condition === 'stormy' ? 'selected' : '' %>>Stormy</option>
                            <option value="windy" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.condition === 'windy' ? 'selected' : '' %>>Windy</option>
                            <option value="foggy" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.condition === 'foggy' ? 'selected' : '' %>>Foggy</option>
                        </select>
                    </div>
                    <div>
                        <label for="weatherWindSpeed" class="block text-xs text-gray-500 mb-1">Wind Speed (km/h)</label>
                        <div class="relative rounded-md shadow-sm">
                            <input type="number" 
                                   id="weatherWindSpeed" 
                                   name="weatherWindSpeed" 
                                   step="0.1"
                                   min="0"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   placeholder="e.g., 12.5"
                                   value="<%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windSpeed ? catchItem.weather.windSpeed : '' %>">
                        </div>
                    </div>
                    <div>
                        <label for="weatherWindDirection" class="block text-xs text-gray-500 mb-1">Wind Direction</label>
                        <select id="weatherWindDirection" 
                                name="weatherWindDirection"
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                            <option value="">Select direction</option>
                            <option value="N" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'N' ? 'selected' : '' %>>North</option>
                            <option value="NNE" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'NNE' ? 'selected' : '' %>>North-Northeast</option>
                            <option value="NE" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'NE' ? 'selected' : '' %>>Northeast</option>
                            <option value="ENE" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'ENE' ? 'selected' : '' %>>East-Northeast</option>
                            <option value="E" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'E' ? 'selected' : '' %>>East</option>
                            <option value="ESE" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'ESE' ? 'selected' : '' %>>East-Southeast</option>
                            <option value="SE" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'SE' ? 'selected' : '' %>>Southeast</option>
                            <option value="SSE" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'SSE' ? 'selected' : '' %>>South-Southeast</option>
                            <option value="S" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'S' ? 'selected' : '' %>>South</option>
                            <option value="SSW" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'SSW' ? 'selected' : '' %>>South-Southwest</option>
                            <option value="SW" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'SW' ? 'selected' : '' %>>Southwest</option>
                            <option value="WSW" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'WSW' ? 'selected' : '' %>>West-Southwest</option>
                            <option value="W" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'W' ? 'selected' : '' %>>West</option>
                            <option value="WNW" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'WNW' ? 'selected' : '' %>>West-Northwest</option>
                            <option value="NW" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'NW' ? 'selected' : '' %>>Northwest</option>
                            <option value="NNW" <%= typeof catchItem !== 'undefined' && catchItem.weather && catchItem.weather.windDirection === 'NNW' ? 'selected' : '' %>>North-Northwest</option>
                        </select>
                    </div>
                </div>
            </div>
            
            <!-- Description -->
            <div>
                <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
                    Catch Story <span class="text-gray-500 text-xs">(optional)</span>
                </label>
                <textarea id="description" 
                          name="description" 
                          rows="4" 
                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                          placeholder="Tell us about your catch..."><%= typeof catchItem !== 'undefined' && catchItem.description ? catchItem.description : '' %></textarea>
            </div>
            
            <!-- Privacy Settings -->
            <div class="border-t border-gray-200 pt-4">
                <div class="flex items-start">
                    <div class="flex items-center h-5">
                        <input id="isPublic" 
                               name="isPublic" 
                               type="checkbox" 
                               class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
                               <%= typeof catchItem === 'undefined' || catchItem.isPublic ? 'checked' : '' %>>
                    </div>
                    <div class="ml-3 text-sm">
                        <label for="isPublic" class="font-medium text-gray-700">Make this catch public</label>
                        <p class="text-gray-500">When public, other users can see your catch in their feed and search results.</p>
                    </div>
                </div>
            </div>
            
            <!-- Form Actions -->
            <div class="flex justify-end space-x-4 pt-6 border-t border-gray-200">
                <a href="/catches" class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">
                    Cancel
                </a>
                <button type="submit" class="px-6 py-2 border border-transparent rounded-lg shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    Save Catch
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Include Leaflet CSS and JS for the map -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>

<!-- Custom JavaScript for the form -->
<script>
    // Image preview functionality
    document.getElementById('image').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const preview = document.getElementById('preview');
                const previewContainer = document.getElementById('imagePreview');
                preview.src = e.target.result;
                previewContainer.classList.remove('hidden');
            }
            reader.readAsDataURL(file);
        }
    });

    // Initialize map
    let map;
    let marker;
    
    function initMap() {
        // Default to a central location (can be set to user's current location)
        const defaultLat = <%= typeof catchItem !== 'undefined' && catchItem.location ? catchItem.location.coordinates[1] : 51.505 %>;
        const defaultLng = <%= typeof catchItem !== 'undefined' && catchItem.location ? catchItem.location.coordinates[0] : -0.09 %>;
        
        map = L.map('map').setView([defaultLat, defaultLng], 13);
        
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);
        
        // Add initial marker if location exists
        if (<%= typeof catchItem !== 'undefined' && catchItem.location ? 'true' : 'false' %>) {
            marker = L.marker([defaultLat, defaultLng]).addTo(map);
            document.getElementById('latitude').value = defaultLat;
            document.getElementById('longitude').value = defaultLng;
        }
        
        // Add click event to update marker and form fields
        map.on('click', function(e) {
            const { lat, lng } = e.latlng;
            
            // Update or create marker
            if (marker) {
                marker.setLatLng([lat, lng]);
            } else {
                marker = L.marker([lat, lng]).addTo(map);
            }
            
            // Update form fields
            document.getElementById('latitude').value = lat.toFixed(6);
            document.getElementById('longitude').value = lng.toFixed(6);
            
            // Reverse geocode to get location name (using OpenStreetMap Nominatim)
            fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`)
                .then(response => response.json())
                .then(data => {
                    let locationName = '';
                    if (data.address) {
                        // Try to get a meaningful location name
                        if (data.address.fishing) locationName = data.address.fishing;
                        else if (data.address.lake) locationName = data.address.lake;
                        else if (data.address.river) locationName = data.address.river;
                        else if (data.address.water) locationName = data.address.water;
                        else if (data.address.village) locationName = data.address.village;
                        else if (data.address.town) locationName = data.address.town;
                        else if (data.address.city) locationName = data.address.city;
                        else if (data.address.county) locationName = data.address.county;
                        else if (data.address.state) locationName = data.address.state;
                        else locationName = data.display_name.split(',')[0];
                        
                        document.getElementById('locationName').value = locationName;
                    }
                });
        });
    }
    
    // Get current location button
    document.getElementById('getLocationBtn').addEventListener('click', function() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(position) {
                const { latitude, longitude } = position.coords;
                map.setView([latitude, longitude], 13);
                
                // Trigger click event to update marker and form fields
                map.fire('click', {
                    latlng: L.latLng(latitude, longitude)
                });
            }, function(error) {
                alert('Unable to retrieve your location: ' + error.message);
            });
        } else {
            alert('Geolocation is not supported by your browser');
        }
    });
    
    // Initialize the map when the page loads
    document.addEventListener('DOMContentLoaded', initMap);
    
    // Handle form submission
    document.querySelector('form').addEventListener('submit', function(e) {
        // Combine date and time if time is provided
        const dateCaught = document.getElementById('dateCaught').value;
        const timeCaught = document.getElementById('timeCaught').value;
        
        // Add weather data to form if available
        const weatherTemp = document.getElementById('weatherTemp').value;
        const weatherCondition = document.getElementById('weatherCondition').value;
        const weatherWindSpeed = document.getElementById('weatherWindSpeed').value;
        const weatherWindDirection = document.getElementById('weatherWindDirection').value;
        
        // Create hidden input for weather data if not already present
        if (!document.getElementById('weatherData')) {
            const weatherInput = document.createElement('input');
            weatherInput.type = 'hidden';
            weatherInput.name = 'weatherData';
            weatherInput.id = 'weatherData';
            document.querySelector('form').appendChild(weatherInput);
        }
        
        // Set weather data as JSON string
        const weatherData = {
            temperature: weatherTemp || null,
            condition: weatherCondition || null,
            windSpeed: weatherWindSpeed || null,
            windDirection: weatherWindDirection || null
        };
        
        document.getElementById('weatherData').value = JSON.stringify(weatherData);
        
        if (timeCaught) {
            const dateTimeString = `${dateCaught}T${timeCaught}`;
            const dateTimeInput = document.createElement('input');
            dateTimeInput.type = 'hidden';
            dateTimeInput.name = 'dateTimeCaught';
            dateTimeInput.value = dateTimeString;
            this.appendChild(dateTimeInput);
        }
        
        // Validate required fields
        const requiredFields = ['species', 'weight', 'locationName', 'dateCaught'];
        let isValid = true;
        
        requiredFields.forEach(field => {
            const element = document.getElementById(field);
            if (!element.value.trim()) {
                element.classList.add('border-red-500');
                isValid = false;
            } else {
                element.classList.remove('border-red-500');
            }
        });
        
        if (!isValid) {
            e.preventDefault();
            alert('Please fill in all required fields.');
        }
    });
</script>
