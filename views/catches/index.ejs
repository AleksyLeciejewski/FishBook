<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - FishHub</title>
    <link rel="icon" type="image/png" href="/images/fishhub-logo.png">
    <link rel="shortcut icon" type="image/png" href="/images/fishhub-logo.png">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .catch-card {
            transition: all 0.3s ease;
        }
        .catch-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        .filter-badge {
            animation: fadeIn 0.3s ease;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-black min-h-screen">
    <!-- Navigation -->
    <nav class="bg-black text-white shadow-lg border-b border-yellow-400">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <a href="/" class="flex items-center">
                <img src="/images/fishhub-logo.png" alt="FishHub" class="h-10">
            </a>
            <div class="flex items-center space-x-4">
                <% if (locals.currentUser) { %>
                    <a href="/catches" class="hover:bg-gray-800 px-3 py-2 rounded transition text-white">My Catches</a>
                    <a href="/trips" class="hover:bg-gray-800 px-3 py-2 rounded transition text-white">Trips</a>
                    <a href="/fishing-spots" class="hover:bg-gray-800 px-3 py-2 rounded transition text-white">Find Spots</a>
                    <div class="relative">
                        <button id="userMenuButton" class="flex items-center space-x-2 focus:outline-none hover:bg-gray-800 px-3 py-2 rounded transition">
                            <img src="<%= currentUser.profilePicture || '/images/default-avatar.png' %>" 
                                 alt="Profile" 
                                 class="w-8 h-8 rounded-full border-2 border-yellow-400">
                            <span><%= currentUser.username %></span>
                            <i class="fas fa-chevron-down text-xs"></i>
                        </button>
                        <div id="userMenuDropdown" class="hidden absolute right-0 mt-2 w-48 bg-gray-900 rounded-lg shadow-xl py-2 z-10 border border-gray-700">
                            <a href="/users/<%= currentUser.id || currentUser._id %>" class="block px-4 py-2 text-white hover:bg-gray-800 transition">
                                <i class="fas fa-user mr-2 text-yellow-400"></i>My Profile
                            </a>
                            <a href="/settings" class="block px-4 py-2 text-white hover:bg-gray-800 transition">
                                <i class="fas fa-cog mr-2 text-yellow-400"></i>Settings
                            </a>
                            <form action="/auth/logout" method="POST" class="border-t border-gray-700 mt-1 pt-1">
                                <button type="submit" class="w-full text-left px-4 py-2 text-white hover:bg-gray-800 transition">
                                    <i class="fas fa-sign-out-alt mr-2 text-red-500"></i>Logout
                                </button>
                            </form>
                        </div>
                    </div>
                    <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            const menuButton = document.getElementById('userMenuButton');
                            const menuDropdown = document.getElementById('userMenuDropdown');
                            if (menuButton && menuDropdown) {
                                menuButton.addEventListener('click', function(e) {
                                    e.stopPropagation();
                                    menuDropdown.classList.toggle('hidden');
                                });
                                document.addEventListener('click', function(e) {
                                    if (!menuButton.contains(e.target) && !menuDropdown.contains(e.target)) {
                                        menuDropdown.classList.add('hidden');
                                    }
                                });
                            }
                        });
                    </script>
                <% } else { %>
                    <a href="/auth/register" class="hover:bg-gray-800 px-3 py-2 rounded transition text-white">Register</a>
                    <a href="/auth/login" class="bg-yellow-400 text-black hover:bg-yellow-300 px-4 py-2 rounded font-bold transition">Login</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <div class="bg-gray-900 text-white py-12 border-b border-gray-700">
        <div class="container mx-auto px-4">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div>
                    <h1 class="text-4xl font-bold mb-2">Community Catches</h1>
                    <p class="text-gray-300 text-lg">Discover amazing catches from anglers around the world</p>
                </div>
                <% if (locals.currentUser) { %>
                    <a href="/catches/new" class="mt-4 md:mt-0 bg-yellow-400 text-black hover:bg-yellow-300 px-6 py-3 rounded-lg font-semibold flex items-center shadow-lg transition transform hover:scale-105">
                        <i class="fas fa-plus mr-2"></i> Log a Catch
                    </a>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8">
        <% if (locals.currentUser && drafts && drafts.length > 0) { %>
            <section class="container mx-auto px-4 py-6">
                <h2 class="text-xl font-semibold text-white mb-4">Your Drafts</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4">
                    <% drafts.forEach(draft => { %>
                        <div id="draft-<%= draft._id %>" class="bg-gray-800 rounded-xl p-4 border border-gray-700 opacity-80">
                            <div class="flex justify-between items-start mb-2">
                                <span class="text-sm font-medium text-gray-300">Draft</span>
                                <span class="text-xs text-gray-400"><%= new Date(draft.updatedAt).toLocaleString() %></span>
                            </div>

                            <div class="text-gray-300 mb-3 text-sm h-20 overflow-hidden">
                                <% if (draft.data && (draft.data.species || draft.data.locationName)) { %>
                                    <div class="mb-1"><strong><%= draft.data.species || '—' %></strong></div>
                                    <div class="text-xs text-gray-400"><%= draft.data.locationName || 'No location' %></div>
                                <% } else { %>
                                    <em class="text-gray-400">Empty draft</em>
                                <% } %>
                            </div>

                            <div class="flex space-x-2">
                                <a href="/catches/new?draftId=<%= draft._id %>" class="flex-1 text-center bg-gray-700 border border-gray-600 text-white px-3 py-2 rounded hover:bg-gray-600">
                                    Resume
                                </a>
                                <button data-id="<%= draft._id %>" class="delete-draft-btn bg-red-900 text-red-300 px-3 py-2 rounded border border-red-800 hover:bg-red-800">
                                    Delete
                                </button>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </section>

            <script>
                (function() {
                    async function deleteDraft(id, btn) {
                        btn.disabled = true;
                        try {
                            const res = await fetch('/drafts/' + id, {
                                method: 'DELETE',
                                credentials: 'same-origin'
                            });
                            if (!res.ok) throw new Error('Failed to delete');
                            const el = document.getElementById('draft-' + id);
                            if (el) el.remove();
                        } catch (err) {
                            console.error('Delete draft error:', err);
                            btn.disabled = false;
                        }
                    }

                    document.addEventListener('click', (e) => {
                        const btn = e.target.closest('.delete-draft-btn');
                        if (!btn) return;
                        const id = btn.getAttribute('data-id');
                        if (!id) return;
                        if (!confirm('Delete this draft?')) return;
                        deleteDraft(id, btn);
                    });
                })();
            </script>
        <% } %>
        <!-- Search and Filter Section -->
        <div class="bg-gray-900 rounded-xl shadow-md p-6 mb-8 border border-gray-700">
            <form action="/catches" method="GET" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <!-- Search -->
                    <div class="md:col-span-2">
                        <label for="search" class="block text-sm font-medium text-gray-300 mb-2">
                            <i class="fas fa-search mr-1"></i> Search
                        </label>
                        <input type="text" 
                               name="search" 
                               id="search" 
                               class="w-full px-4 py-2 border border-gray-600 bg-gray-800 text-white rounded-lg focus:ring-2 focus:ring-yellow-400 focus:border-yellow-400 transition" 
                               placeholder="Search by species, location..."
                               value="<%= search %>">
                    </div>
                    
                    <!-- Species Filter -->
                    <div>
                        <label for="species" class="block text-sm font-medium text-gray-300 mb-2">
                            <i class="fas fa-fish mr-1"></i> Species
                        </label>
                        <select id="species" 
                                name="species" 
                                class="w-full px-4 py-2 border border-gray-600 bg-gray-800 text-white rounded-lg focus:ring-2 focus:ring-yellow-400 focus:border-yellow-400 transition">
                            <option value="">All Species</option>
                            <option value="bass" <%= species === 'bass' ? 'selected' : '' %>>Bass</option>
                            <option value="trout" <%= species === 'trout' ? 'selected' : '' %>>Trout</option>
                            <option value="salmon" <%= species === 'salmon' ? 'selected' : '' %>>Salmon</option>
                            <option value="pike" <%= species === 'pike' ? 'selected' : '' %>>Pike</option>
                            <option value="carp" <%= species === 'carp' ? 'selected' : '' %>>Carp</option>
                            <option value="catfish" <%= species === 'catfish' ? 'selected' : '' %>>Catfish</option>
                            <option value="perch" <%= species === 'perch' ? 'selected' : '' %>>Perch</option>
                        </select>
                    </div>
                    
                    <!-- Submit Button -->
                    <div class="flex items-end">
                        <button type="submit" class="w-full bg-yellow-400 hover:bg-yellow-300 text-black px-6 py-2 rounded-lg font-medium transition transform hover:scale-105 shadow-md">
                            <i class="fas fa-filter mr-2"></i> Apply Filters
                        </button>
                    </div>
                </div>
                
                <!-- Weight Range -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="minWeight" class="block text-sm font-medium text-gray-300 mb-2">
                            <i class="fas fa-weight-hanging mr-1"></i> Min Weight (kg)
                        </label>
                        <input type="number" 
                               name="minWeight" 
                               id="minWeight" 
                               step="0.1"
                               class="w-full px-4 py-2 border border-gray-600 bg-gray-800 text-white rounded-lg focus:ring-2 focus:ring-yellow-400 focus:border-yellow-400 transition" 
                               placeholder="0.0"
                               value="<%= minWeight %>">
                    </div>
                    <div>
                        <label for="maxWeight" class="block text-sm font-medium text-gray-300 mb-2">
                            <i class="fas fa-weight-hanging mr-1"></i> Max Weight (kg)
                        </label>
                        <input type="number" 
                               name="maxWeight" 
                               id="maxWeight" 
                               step="0.1"
                               class="w-full px-4 py-2 border border-gray-600 bg-gray-800 text-white rounded-lg focus:ring-2 focus:ring-yellow-400 focus:border-yellow-400 transition" 
                               placeholder="100.0"
                               value="<%= maxWeight %>">
                    </div>
                </div>
            </form>
            
            <!-- Active Filters Display -->
            <% if (species || minWeight || maxWeight || search) { %>
                <div class="mt-4 pt-4 border-t border-gray-700">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="text-sm font-medium text-gray-300">Active Filters:</span>
                        <% if (species) { %>
                            <span class="filter-badge inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-400 bg-opacity-20 text-yellow-400 border border-yellow-400">
                                <i class="fas fa-fish mr-1"></i> <%= species %>
                                <a href="?<%= new URLSearchParams({...req.query, species: ''}).toString() %>" class="ml-2 hover:text-blue-600">×</a>
                            </span>
                        <% } %>
                        <% if (minWeight) { %>
                            <span class="filter-badge inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-900 bg-opacity-50 text-green-300 border border-green-700">
                                Min: <%= minWeight %>kg
                            </span>
                        <% } %>
                        <% if (maxWeight) { %>
                            <span class="filter-badge inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-900 bg-opacity-50 text-green-300 border border-green-700">
                                Max: <%= maxWeight %>kg
                            </span>
                        <% } %>
                        <% if (search) { %>
                            <span class="filter-badge inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-900 bg-opacity-50 text-purple-300 border border-purple-700">
                                <i class="fas fa-search mr-1"></i> "<%= search %>"
                            </span>
                        <% } %>
                        <a href="/catches" class="text-sm text-red-400 hover:text-red-300 font-medium ml-2">
                            <i class="fas fa-times-circle mr-1"></i> Clear All
                        </a>
                    </div>
                </div>
            <% } %>
        </div>

        <!-- Catches Grid -->
        <% if (catches && catches.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% catches.forEach(catchItem => { %>
                    <div class="catch-card bg-gray-800 rounded-xl shadow-md overflow-hidden border border-gray-700 hover:border-yellow-400">
                        <!-- Image -->
                        <div class="relative h-56 bg-gradient-to-br from-blue-400 to-indigo-500 overflow-hidden">
                            <% if (catchItem.image) { %>
                                <img src="/<%= catchItem.image %>" 
                                     alt="<%= catchItem.species %>" 
                                     class="w-full h-full object-cover">
                            <% } else { %>
                                <div class="flex items-center justify-center h-full">
                                    <i class="fas fa-fish text-white text-6xl opacity-50"></i>
                                </div>
                            <% } %>
                            <!-- Species Badge -->
                            <div class="absolute top-4 left-4">
                                <span class="bg-white bg-opacity-95 text-gray-800 px-3 py-1 rounded-full text-sm font-semibold shadow-lg">
                                    <i class="fas fa-fish mr-1 text-blue-600"></i> <%= catchItem.species %>
                                </span>
                            </div>
                            <!-- Edit/Delete Actions -->
                            <% if (currentUser && (currentUser.isAdmin || String(currentUser._id) === String(catchItem.user._id))) { %>
                                <div class="absolute top-4 right-4 flex space-x-2">
                                    <a href="/catches/<%= catchItem._id %>/edit" 
                                       class="bg-white bg-opacity-95 hover:bg-opacity-100 text-blue-600 w-8 h-8 rounded-full flex items-center justify-center shadow-lg transition"
                                       title="Edit">
                                        <i class="fas fa-edit text-sm"></i>
                                    </a>
                                    <form action="/catches/<%= catchItem._id %>?_method=DELETE" method="POST" class="inline">
                                        <button type="submit" 
                                                class="bg-white bg-opacity-95 hover:bg-opacity-100 text-red-600 w-8 h-8 rounded-full flex items-center justify-center shadow-lg transition"
                                                onclick="return confirm('Are you sure you want to delete this catch?')"
                                                title="Delete">
                                            <i class="fas fa-trash text-sm"></i>
                                        </button>
                                    </form>
                                </div>
                            <% } %>
                        </div>
                        
                        <!-- Content -->
                        <div class="p-5">
                            <!-- Stats -->
                            <div class="flex items-center space-x-4 text-sm font-medium mb-3">
                                <span class="flex items-center text-blue-600">
                                    <i class="fas fa-weight-hanging mr-1"></i>
                                    <%= catchItem.weight %> kg
                                </span>
                                <% if (catchItem.length) { %>
                                    <span class="flex items-center text-green-600">
                                        <i class="fas fa-ruler-vertical mr-1"></i>
                                        <%= catchItem.length %> cm
                                    </span>
                                <% } %>
                            </div>
                            
                            <!-- Location -->
                            <div class="flex items-center text-sm text-gray-600 mb-3">
                                <i class="fas fa-map-marker-alt mr-2 text-red-500"></i>
                                <span class="truncate"><%= catchItem.location.name %></span>
                            </div>
                            
                            <!-- Description -->
                            <% if (catchItem.description) { %>
                                <p class="text-sm text-gray-600 mb-4 line-clamp-2">
                                    <%= catchItem.description.length > 80 ? 
                                        catchItem.description.substring(0, 80) + '...' : 
                                        catchItem.description %>
                                </p>
                            <% } %>
                            
                            <!-- Footer -->
                            <div class="flex items-center justify-between pt-4 border-t border-gray-700">
                                <!-- User Info -->
                                <div class="flex items-center space-x-2">
                                    <img src="<%= catchItem.user.profilePicture || '/images/default-avatar.png' %>" 
                                         alt="<%= catchItem.user.username %>" 
                                         class="w-8 h-8 rounded-full border-2 border-yellow-400">
                                    <div class="text-xs">
                                        <a href="/users/<%= catchItem.user._id %>" class="font-medium text-white hover:text-yellow-400 block">
                                            <%= catchItem.user.username %>
                                        </a>
                                        <time class="text-gray-400" datetime="<%= new Date(catchItem.dateCaught).toISOString() %>">
                                            <%= new Date(catchItem.dateCaught).toLocaleDateString('en-US', { 
                                                month: 'short', 
                                                day: 'numeric' 
                                            }) %>
                                        </time>
                                    </div>
                                </div>
                                
                                <!-- Actions -->
                                <div class="flex items-center space-x-3 text-sm">
                                    <% if (currentUser) { %>
                                        <button class="like-btn flex items-center <%= catchItem.likes.some(like => String(like) === String(currentUser._id)) ? 'text-red-500' : 'text-gray-400' %> hover:text-red-500 transition"
                                                data-catch-id="<%= catchItem._id %>"
                                                data-liked="<%= catchItem.likes.some(like => String(like) === String(currentUser._id)) %>">
                                            <i class="<%= catchItem.likes.some(like => String(like) === String(currentUser._id)) ? 'fas' : 'far' %> fa-heart mr-1"></i>
                                            <span class="like-count"><%= catchItem.likes.length %></span>
                                        </button>
                                    <% } else { %>
                                        <a href="/auth/login" class="flex items-center text-gray-400 hover:text-red-500 transition">
                                            <i class="far fa-heart mr-1"></i>
                                            <span><%= catchItem.likes.length %></span>
                                        </a>
                                    <% } %>
                                    <a href="/catches/<%= catchItem._id %>" class="flex items-center text-gray-400 hover:text-yellow-400 transition">
                                        <i class="far fa-comment mr-1"></i>
                                        <span><%= catchItem.comments ? catchItem.comments.length : 0 %></span>
                                    </a>
                                </div>
                            </div>
                            
                            <!-- View Details Button -->
                            <a href="/catches/<%= catchItem._id %>" class="mt-4 block w-full text-center bg-yellow-400 hover:bg-yellow-300 text-black py-2 rounded-lg font-medium transition transform hover:scale-105">
                                View Details
                            </a>
                        </div>
                    </div>
                    <% }); %>
                </div>
                
            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <div class="mt-12 flex justify-center">
                    <nav class="relative z-0 inline-flex rounded-lg shadow-md overflow-hidden" aria-label="Pagination">
                        <% if (currentPage > 1) { %>
                            <a href="?page=<%= currentPage - 1 %><%= queryString ? '&' + queryString : '' %>" 
                               class="relative inline-flex items-center px-4 py-2 bg-gray-800 border-r border-gray-700 text-sm font-medium text-gray-300 hover:bg-gray-700 transition">
                                <i class="fas fa-chevron-left mr-2"></i> Previous
                            </a>
                        <% } %>
                        
                        <% for (let i = 1; i <= Math.min(totalPages, 5); i++) { %>
                            <% if (i === currentPage) { %>
                                <span class="relative inline-flex items-center px-4 py-2 bg-yellow-400 text-sm font-medium text-black">
                                    <%= i %>
                                </span>
                            <% } else { %>
                                <a href="?page=<%= i %><%= queryString ? '&' + queryString : '' %>" 
                                   class="relative inline-flex items-center px-4 py-2 bg-gray-800 border-r border-gray-700 text-sm font-medium text-gray-300 hover:bg-gray-700 transition">
                                    <%= i %>
                                </a>
                            <% } %>
                        <% } %>
                        
                        <% if (currentPage < totalPages) { %>
                            <a href="?page=<%= currentPage + 1 %><%= queryString ? '&' + queryString : '' %>" 
                               class="relative inline-flex items-center px-4 py-2 bg-gray-800 text-sm font-medium text-gray-300 hover:bg-gray-700 transition">
                                Next <i class="fas fa-chevron-right ml-2"></i>
                            </a>
                        <% } %>
                    </nav>
                </div>
            <% } %>
            
        <% } else { %>
            <!-- Empty State -->
            <div class="bg-gray-900 rounded-xl shadow-md p-12 text-center border border-gray-700">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gray-800 border-2 border-yellow-400 mb-6">
                    <i class="fas fa-fish text-4xl text-yellow-400"></i>
                </div>
                <h3 class="text-2xl font-bold text-white mb-2">No Catches Found</h3>
                <p class="text-gray-400 mb-8 max-w-md mx-auto">
                    <% if (species || minWeight || maxWeight || search) { %>
                        No catches match your current filters. Try adjusting your search criteria.
                    <% } else { %>
                        Be the first to share your amazing catch with the community!
                    <% } %>
                </p>
                <% if (locals.currentUser) { %>
                    <a href="/catches/new" class="inline-flex items-center px-6 py-3 bg-yellow-400 hover:bg-yellow-300 text-black font-semibold rounded-lg shadow-lg transition transform hover:scale-105">
                        <i class="fas fa-plus mr-2"></i> Log Your First Catch
                    </a>
                <% } %>
            </div>
        <% } %>
    </main>
    
    <!-- Footer -->
    <footer class="bg-black border-t border-gray-800 mt-12">
        <div class="container mx-auto px-4 py-8">
            <div class="text-center text-gray-400">
                <p class="text-sm">
                    &copy; <%= new Date().getFullYear() %> FishHub. Made with <i class="fas fa-heart text-yellow-400"></i> by anglers, for anglers.
                </p>
            </div>
        </div>
    </footer>

    <script>
        // Like functionality
        document.querySelectorAll('.like-btn').forEach(button => {
            button.addEventListener('click', async function(e) {
                e.preventDefault();
                e.stopPropagation();
                
                const catchId = this.dataset.catchId;
                const isLiked = this.dataset.liked === 'true';
                
                try {
                    const response = await fetch(`/catches/${catchId}/like`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });

                    if (response.ok) {
                        const data = await response.json();
                        const icon = this.querySelector('i');
                        const count = this.querySelector('.like-count');
                        
                        count.textContent = data.likes.length;
                        
                        if (isLiked) {
                            this.classList.remove('text-red-500');
                            this.classList.add('text-gray-400');
                            icon.classList.remove('fas');
                            icon.classList.add('far');
                            this.dataset.liked = 'false';
                        } else {
                            this.classList.add('text-red-500');
                            this.classList.remove('text-gray-400');
                            icon.classList.remove('far');
                            icon.classList.add('fas');
                            this.dataset.liked = 'true';
                        }
                    } else {
                        console.error('Error toggling like');
                    }
                } catch (error) {
                    console.error('Error:', error);
                }
            });
        });
    </script>
</body>
</html>
