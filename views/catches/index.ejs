<div class="flex flex-col md:flex-row gap-6">
    <!-- Main Content -->
    <div class="md:w-2/3">
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <div class="flex justify-between items-center mb-6">
                <h1 class="text-2xl font-bold text-gray-800">Recent Catches</h1>
                <a href="/catches/new" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg flex items-center">
                    <i class="fas fa-plus mr-2"></i> New Catch
                </a>
            </div>
            
            <!-- Search and Filter -->
            <div class="mb-6">
                <form action="/catches" method="GET" class="space-y-4">
                    <div class="flex flex-col md:flex-row gap-4">
                        <div class="flex-1">
                            <label for="search" class="sr-only">Search</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fas fa-search text-gray-400"></i>
                                </div>
                                <input type="text" 
                                       name="search" 
                                       id="search" 
                                       class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500" 
                                       placeholder="Search catches..."
                                       value="<%= typeof search !== 'undefined' ? search : '' %>">
                            </div>
                        </div>
                        <div class="w-full md:w-48">
                            <label for="species" class="sr-only">Species</label>
                            <select id="species" 
                                    name="species" 
                                    class="block w-full pl-3 pr-10 py-2 text-base border border-gray-300 focus:outline-none focus:ring-blue-500 focus:border-blue-500 rounded-lg">
                                <option value="">All Species</option>
                                <option value="bass" <%= species === 'bass' ? 'selected' : '' %>>Bass</option>
                                <option value="trout" <%= species === 'trout' ? 'selected' : '' %>>Trout</option>
                                <option value="salmon" <%= species === 'salmon' ? 'selected' : '' %>>Salmon</option>
                                <option value="pike" <%= species === 'pike' ? 'selected' : '' %>>Pike</option>
                                <option value="carp" <%= species === 'carp' ? 'selected' : '' %>>Carp</option>
                            </select>
                        </div>
                        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg">
                            Apply Filters
                        </button>
                    </div>
                </form>
            </div>
            
            <!-- Catches List -->
            <% if (catches && catches.length > 0) { %>
                <div class="space-y-6">
                    <% catches.forEach(catchItem => { %>
                        <div class="border rounded-lg overflow-hidden hover:shadow-md transition duration-300">
                            <div class="md:flex">
                                <div class="md:flex-shrink-0 md:w-48 h-48 bg-gray-200 overflow-hidden">
                                    <img src="<%= catchItem.image || '/images/default-catch.jpg' %>" 
                                         alt="<%= catchItem.species %>" 
                                         class="w-full h-full object-cover hover:scale-105 transition-transform duration-300">
                                </div>
                                <div class="p-6 flex-1">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <h2 class="text-xl font-semibold text-gray-900">
                                                <a href="/catches/<%= catchItem._id %>" class="hover:underline">
                                                    <%= catchItem.species %>
                                                </a>
                                            </h2>
                                            <div class="mt-1 text-sm text-gray-600">
                                                <span class="inline-flex items-center mr-4">
                                                    <i class="fas fa-weight-hanging mr-1"></i>
                                                    <%= catchItem.weight %> kg
                                                </span>
                                                <% if (catchItem.length) { %>
                                                    <span class="inline-flex items-center mr-4">
                                                        <i class="fas fa-ruler-vertical mr-1"></i>
                                                        <%= catchItem.length %> cm
                                                    </span>
                                                <% } %>
                                                <span class="inline-flex items-center">
                                                    <i class="fas fa-map-marker-alt mr-1"></i>
                                                    <%= catchItem.location.name %>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="flex space-x-2">
                                            <% if (currentUser && (currentUser.isAdmin || currentUser._id.toString() === catchItem.user._id.toString())) { %>
                                                <a href="/catches/<%= catchItem._id %>/edit" 
                                                   class="text-blue-600 hover:text-blue-800"
                                                   title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form action="/catches/<%= catchItem._id %>?_method=DELETE" method="POST" class="inline">
                                                    <button type="submit" 
                                                            class="text-red-600 hover:text-red-800"
                                                            onclick="return confirm('Are you sure you want to delete this catch?')"
                                                            title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </div>
                                    
                                    <% if (catchItem.description) { %>
                                        <p class="mt-3 text-gray-600">
                                            <%= catchItem.description.length > 200 ? 
                                                catchItem.description.substring(0, 200) + '...' : 
                                                catchItem.description %>
                                            <% if (catchItem.description.length > 200) { %>
                                                <a href="/catches/<%= catchItem._id %>" class="text-blue-600 hover:underline">Read more</a>
                                            <% } %>
                                        </p>
                                    <% } %>
                                    
                                    <div class="mt-4 flex items-center justify-between">
                                        <div class="flex items-center">
                                            <img src="<%= catchItem.user.profilePicture || '/images/default-avatar.png' %>" 
                                                 alt="<%= catchItem.user.username %>" 
                                                 class="w-8 h-8 rounded-full border-2 border-white shadow-sm">
                                            <div class="ml-3">
                                                <p class="text-sm font-medium text-gray-900">
                                                    <a href="/users/<%= catchItem.user._id %>" class="hover:underline">
                                                        <%= catchItem.user.username %>
                                                    </a>
                                                </p>
                                                <div class="flex space-x-1 text-sm text-gray-500">
                                                    <time datetime="<%= new Date(catchItem.dateCaught).toISOString() %>">
                                                        <%= new Date(catchItem.dateCaught).toLocaleDateString('en-US', { 
                                                            year: 'numeric', 
                                                            month: 'short', 
                                                            day: 'numeric' 
                                                        }) %>
                                                    </time>
                                                    <span aria-hidden="true">·</span>
                                                    <span><%= catchItem.comments.length %> comments</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="flex items-center space-x-4">
                                            <button class="flex items-center text-gray-500 hover:text-blue-600">
                                                <i class="far fa-thumbs-up mr-1"></i>
                                                <span><%= catchItem.likes.length %></span>
                                            </button>
                                            <a href="/catches/<%= catchItem._id %>#comments" class="flex items-center text-gray-500 hover:text-blue-600">
                                                <i class="far fa-comment mr-1"></i>
                                                <span><%= catchItem.comments.length %></span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
                
                <!-- Pagination -->
                <% if (totalPages > 1) { %>
                    <div class="mt-8 flex justify-center">
                        <nav class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                            <% if (currentPage > 1) { %>
                                <a href="?page=<%= currentPage - 1 %><%= queryString ? '&' + queryString : '' %>" 
                                   class="relative inline-flex items-center px-2 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                    <span class="sr-only">Previous</span>
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            <% } %>
                            
                            <% for (let i = 1; i <= totalPages; i++) { %>
                                <% if (i === currentPage) { %>
                                    <span class="relative inline-flex items-center px-4 py-2 border border-blue-500 bg-blue-50 text-sm font-medium text-blue-600">
                                        <%= i %>
                                    </span>
                                <% } else { %>
                                    <a href="?page=<%= i %><%= queryString ? '&' + queryString : '' %>" 
                                       class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                                        <%= i %>
                                    </a>
                                <% } %>
                            <% } %>
                            
                            <% if (currentPage < totalPages) { %>
                                <a href="?page=<%= currentPage + 1 %><%= queryString ? '&' + queryString : '' %>" 
                                   class="relative inline-flex items-center px-2 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-50">
                                    <span class="sr-only">Next</span>
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            <% } %>
                        </nav>
                    </div>
                <% } %>
                
            <% } else { %>
                <div class="text-center py-12">
                    <i class="fas fa-fish text-5xl text-gray-300 mb-4"></i>
                    <h3 class="text-lg font-medium text-gray-900">No catches yet</h3>
                    <p class="mt-1 text-sm text-gray-500">Be the first to share your catch!</p>
                    <div class="mt-6">
                        <a href="/catches/new" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                            <i class="fas fa-plus -ml-1 mr-2"></i>
                            New Catch
                        </a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
    
    <!-- Sidebar -->
    <div class="md:w-1/3">
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <h2 class="text-lg font-medium text-gray-900 mb-4">Top Anglers</h2>
            <div class="space-y-4">
                <% if (topAnglers && topAnglers.length > 0) { %>
                    <% topAnglers.forEach((angler, index) => { %>
                        <div class="flex items-center">
                            <span class="w-6 h-6 flex items-center justify-center bg-blue-100 text-blue-800 text-xs font-semibold rounded-full mr-3">
                                <%= index + 1 %>
                            </span>
                            <img src="<%= angler.profilePicture || '/images/default-avatar.png' %>" 
                                 alt="<%= angler.username %>" 
                                 class="w-10 h-10 rounded-full border-2 border-white shadow-sm">
                            <div class="ml-3">
                                <p class="text-sm font-medium text-gray-900">
                                    <a href="/users/<%= angler._id %>" class="hover:underline">
                                        <%= angler.username %>
                                    </a>
                                </p>
                                <p class="text-xs text-gray-500">
                                    <%= angler.catchCount %> catches
                                </p>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p class="text-sm text-gray-500">No anglers to display yet.</p>
                <% } %>
            </div>
        </div>
        
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-lg font-medium text-gray-900 mb-4">Recent Activity</h2>
            <div class="space-y-4">
                <% if (recentActivity && recentActivity.length > 0) { %>
                    <% recentActivity.forEach(activity => { %>
                        <div class="flex">
                            <div class="flex-shrink-0">
                                <img src="<%= activity.user.profilePicture || '/images/default-avatar.png' %>" 
                                     alt="<%= activity.user.username %>" 
                                     class="w-8 h-8 rounded-full border-2 border-white shadow-sm">
                            </div>
                            <div class="ml-3">
                                <p class="text-sm text-gray-900">
                                    <a href="/users/<%= activity.user._id %>" class="font-medium hover:underline">
                                        <%= activity.user.username %>
                                    </a>
                                    <%= activity.action %>
                                    <% if (activity.type === 'catch') { %>
                                        <a href="/catches/<%= activity.referenceId %>" class="font-medium text-blue-600 hover:underline">
                                            <%= activity.details.species %>
                                        </a>
                                    <% } else if (activity.type === 'trip') { %>
                                        <a href="/trips/<%= activity.referenceId %>" class="font-medium text-blue-600 hover:underline">
                                            <%= activity.details.title %>
                                        </a>
                                    <% } %>
                                </p>
                                <p class="text-xs text-gray-500">
                                    <%= new Date(activity.timestamp).toLocaleString('en-US', { 
                                        month: 'short', 
                                        day: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    }) %>
                                </p>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p class="text-sm text-gray-500">No recent activity to display.</p>
                <% } %>
            </div>
        </div>
    </div>
</div>
