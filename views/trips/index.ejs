<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - FishBook</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .trip-card {
            transition: all 0.3s ease;
        }
        .trip-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen">
    <!-- Navigation -->
    <nav class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-lg">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <a href="/" class="text-2xl font-bold flex items-center">
                <i class="fas fa-fish mr-2"></i>FishBook
            </a>
            <div class="flex items-center space-x-4">
                <% if (locals.currentUser) { %>
                    <a href="/catches" class="hover:bg-white hover:bg-opacity-20 px-3 py-2 rounded transition">My Catches</a>
                    <a href="/trips" class="hover:bg-white hover:bg-opacity-20 px-3 py-2 rounded transition">Trips</a>
                    <a href="/fishing-spots" class="hover:bg-white hover:bg-opacity-20 px-3 py-2 rounded transition">Find Spots</a>
                    <div class="relative group">
                        <button class="flex items-center space-x-2 focus:outline-none hover:bg-white hover:bg-opacity-20 px-3 py-2 rounded transition">
                            <img src="<%= currentUser.profilePicture || '/images/default-avatar.png' %>" 
                                 alt="Profile" 
                                 class="w-8 h-8 rounded-full border-2 border-white">
                            <span><%= currentUser.username %></span>
                            <i class="fas fa-chevron-down text-xs"></i>
                        </button>
                        <div class="hidden group-hover:block absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-xl py-2 z-10">
                            <a href="/users/<%= currentUser._id %>" class="block px-4 py-2 text-gray-800 hover:bg-blue-50 transition">
                                <i class="fas fa-user mr-2 text-blue-600"></i>Profile
                            </a>
                            <a href="/settings" class="block px-4 py-2 text-gray-800 hover:bg-blue-50 transition">
                                <i class="fas fa-cog mr-2 text-blue-600"></i>Settings
                            </a>
                            <form action="/auth/logout" method="POST" class="border-t border-gray-200 mt-1 pt-1">
                                <button type="submit" class="w-full text-left px-4 py-2 text-gray-800 hover:bg-red-50 transition">
                                    <i class="fas fa-sign-out-alt mr-2 text-red-600"></i>Logout
                                </button>
                            </form>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/auth/register" class="hover:bg-white hover:bg-opacity-20 px-3 py-2 rounded transition">Register</a>
                    <a href="/auth/login" class="bg-white text-blue-600 hover:bg-gray-100 px-4 py-2 rounded-lg font-medium transition shadow-md">Login</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <div class="bg-gradient-to-r from-blue-600 to-indigo-600 text-white py-12">
        <div class="container mx-auto px-4">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div>
                    <h1 class="text-4xl font-bold mb-2">Fishing Trips</h1>
                    <p class="text-blue-100 text-lg">Join exciting fishing adventures with fellow anglers</p>
                </div>
                <% if (locals.currentUser) { %>
                    <a href="/trips/new" class="mt-4 md:mt-0 bg-white text-blue-600 hover:bg-gray-100 px-6 py-3 rounded-lg font-semibold flex items-center shadow-lg transition transform hover:scale-105">
                        <i class="fas fa-plus mr-2"></i> Plan a Trip
                    </a>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8">
        <!-- Filter Section -->
        <div class="bg-white rounded-xl shadow-md p-6 mb-8">
            <form action="/trips" method="GET" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <!-- Location Search -->
                    <div class="md:col-span-2">
                        <label for="location" class="block text-sm font-medium text-gray-700 mb-2">
                            <i class="fas fa-map-marker-alt mr-1"></i> Location
                        </label>
                        <input type="text" 
                               name="location" 
                               id="location" 
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition" 
                               placeholder="Search by location..."
                               value="<%= location || '' %>">
                    </div>
                    
                    <!-- Status Filter -->
                    <div>
                        <label for="status" class="block text-sm font-medium text-gray-700 mb-2">
                            <i class="fas fa-filter mr-1"></i> Status
                        </label>
                        <select id="status" 
                                name="status" 
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition">
                            <option value="">All Trips</option>
                            <option value="upcoming" <%= status === 'upcoming' ? 'selected' : '' %>>Upcoming</option>
                            <option value="in_progress" <%= status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                            <option value="completed" <%= status === 'completed' ? 'selected' : '' %>>Completed</option>
                        </select>
                    </div>
                    
                    <!-- Submit Button -->
                    <div class="flex items-end">
                        <button type="submit" class="w-full bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white px-6 py-2 rounded-lg font-medium transition transform hover:scale-105 shadow-md">
                            <i class="fas fa-search mr-2"></i> Search
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Trips Grid -->
        <% if (trips && trips.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% trips.forEach(trip => { %>
                    <div class="trip-card bg-white rounded-xl shadow-md overflow-hidden">
                        <!-- Header with Status Badge -->
                        <div class="relative h-48 bg-gradient-to-br from-green-400 to-teal-500 overflow-hidden">
                            <% if (trip.images && trip.images.length > 0) { %>
                                <img src="/<%= trip.images[0] %>" 
                                     alt="<%= trip.title %>" 
                                     class="w-full h-full object-cover">
                            <% } else { %>
                                <div class="flex items-center justify-center h-full">
                                    <i class="fas fa-ship text-white text-6xl opacity-50"></i>
                                </div>
                            <% } %>
                            <!-- Status Badge -->
                            <div class="absolute top-4 left-4">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-bold shadow-lg
                                    <%= trip.status === 'upcoming' ? 'bg-blue-500 text-white' : 
                                       trip.status === 'in_progress' ? 'bg-yellow-500 text-white' : 
                                       trip.status === 'completed' ? 'bg-green-500 text-white' : 
                                       'bg-red-500 text-white' %>">
                                    <i class="fas fa-circle text-xs mr-2"></i>
                                    <%= trip.status.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase()) %>
                                </span>
                            </div>
                            <!-- Creator Badge -->
                            <% if (currentUser && trip.createdBy && String(trip.createdBy._id) === String(currentUser._id)) { %>
                                <div class="absolute top-4 right-4">
                                    <span class="bg-white bg-opacity-95 text-gray-800 px-3 py-1 rounded-full text-sm font-semibold shadow-lg">
                                        <i class="fas fa-crown mr-1 text-yellow-500"></i> Your Trip
                                    </span>
                                </div>
                            <% } %>
                        </div>
                        
                        <!-- Content -->
                        <div class="p-5">
                            <!-- Title -->
                            <h3 class="font-bold text-xl text-gray-800 mb-3">
                                <a href="/trips/<%= trip._id %>" class="hover:text-blue-600 transition">
                                    <%= trip.title %>
                                </a>
                            </h3>
                            
                            <!-- Location -->
                            <div class="flex items-center text-sm text-gray-600 mb-3">
                                <i class="fas fa-map-marker-alt mr-2 text-red-500"></i>
                                <span class="truncate"><%= trip.location.name %></span>
                            </div>
                            
                            <!-- Dates -->
                            <div class="flex items-center text-sm text-gray-600 mb-3">
                                <i class="far fa-calendar-alt mr-2 text-blue-500"></i>
                                <span>
                                    <%= new Date(trip.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %> - 
                                    <%= new Date(trip.endDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                </span>
                            </div>
                            
                            <!-- Description -->
                            <% if (trip.description) { %>
                                <p class="text-sm text-gray-600 mb-4 line-clamp-2">
                                    <%= trip.description.length > 100 ? 
                                        trip.description.substring(0, 100) + '...' : 
                                        trip.description %>
                                </p>
                            <% } %>
                            
                            <!-- Participants -->
                            <div class="flex items-center justify-between pt-4 border-t border-gray-100 mb-4">
                                <div class="flex items-center">
                                    <span class="text-sm font-semibold text-gray-600 mr-3">Participants:</span>
                                    <div class="flex -space-x-3">
                                        <% trip.participants.slice(0, 4).forEach(participant => { %>
                                            <img src="<%= participant.user.profilePicture || '/images/default-avatar.png' %>" 
                                                 alt="<%= participant.user.username %>" 
                                                 class="w-8 h-8 rounded-full border-2 border-white shadow-md hover:scale-110 transition-transform duration-200"
                                                 title="<%= participant.user.username %>">
                                        <% }); %>
                                        <% if (trip.participants.length > 4) { %>
                                            <span class="flex items-center justify-center w-8 h-8 rounded-full bg-gradient-to-br from-gray-300 to-gray-400 text-white text-xs font-bold border-2 border-white shadow-md">
                                                +<%= trip.participants.length - 4 %>
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                                <span class="text-sm text-gray-500">
                                    <%= trip.participants.length %>/<%= trip.maxParticipants %>
                                </span>
                            </div>
                            
                            <!-- View Details Button -->
                            <a href="/trips/<%= trip._id %>" class="block w-full text-center bg-gradient-to-r from-green-600 to-teal-600 hover:from-green-700 hover:to-teal-700 text-white py-2 rounded-lg font-medium transition transform hover:scale-105">
                                View Details
                            </a>
                        </div>
                    </div>
                <% }); %>
            </div>
            
            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <div class="mt-12 flex justify-center">
                    <nav class="relative z-0 inline-flex rounded-lg shadow-md overflow-hidden" aria-label="Pagination">
                        <% if (currentPage > 1) { %>
                            <a href="?page=<%= currentPage - 1 %><%= location ? '&location=' + location : '' %><%= status ? '&status=' + status : '' %>" 
                               class="relative inline-flex items-center px-4 py-2 bg-white border-r border-gray-200 text-sm font-medium text-gray-700 hover:bg-blue-50 transition">
                                <i class="fas fa-chevron-left mr-2"></i> Previous
                            </a>
                        <% } %>
                        
                        <% for (let i = 1; i <= Math.min(totalPages, 5); i++) { %>
                            <% if (i === currentPage) { %>
                                <span class="relative inline-flex items-center px-4 py-2 bg-gradient-to-r from-blue-600 to-indigo-600 text-sm font-medium text-white">
                                    <%= i %>
                                </span>
                            <% } else { %>
                                <a href="?page=<%= i %><%= location ? '&location=' + location : '' %><%= status ? '&status=' + status : '' %>" 
                                   class="relative inline-flex items-center px-4 py-2 bg-white border-r border-gray-200 text-sm font-medium text-gray-700 hover:bg-blue-50 transition">
                                    <%= i %>
                                </a>
                            <% } %>
                        <% } %>
                        
                        <% if (currentPage < totalPages) { %>
                            <a href="?page=<%= currentPage + 1 %><%= location ? '&location=' + location : '' %><%= status ? '&status=' + status : '' %>" 
                               class="relative inline-flex items-center px-4 py-2 bg-white text-sm font-medium text-gray-700 hover:bg-blue-50 transition">
                                Next <i class="fas fa-chevron-right ml-2"></i>
                            </a>
                        <% } %>
                    </nav>
                </div>
            <% } %>
            
        <% } else { %>
            <!-- Empty State -->
            <div class="bg-white rounded-xl shadow-md p-12 text-center">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gradient-to-br from-green-100 to-teal-100 mb-6">
                    <i class="fas fa-ship text-4xl text-green-600"></i>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-2">No Trips Found</h3>
                <p class="text-gray-600 mb-8 max-w-md mx-auto">
                    <% if (location || status) { %>
                        No trips match your current filters. Try adjusting your search criteria.
                    <% } else { %>
                        Be the first to organize a fishing trip and invite others to join!
                    <% } %>
                </p>
                <% if (locals.currentUser) { %>
                    <a href="/trips/new" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-green-600 to-teal-600 hover:from-green-700 hover:to-teal-700 text-white font-semibold rounded-lg shadow-lg transition transform hover:scale-105">
                        <i class="fas fa-plus mr-2"></i> Plan Your First Trip
                    </a>
                <% } %>
            </div>
        <% } %>
    </main>
    
    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 mt-12">
        <div class="container mx-auto px-4 py-8">
            <div class="text-center text-gray-600">
                <p class="text-sm">
                    &copy; <%= new Date().getFullYear() %> FishBook. Made with <i class="fas fa-heart text-red-500"></i> by anglers, for anglers.
                </p>
            </div>
        </div>
    </footer>
</body>
</html>
