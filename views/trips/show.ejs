<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= trip.title %> - FishHub</title>
    <link rel="icon" type="image/png" href="/images/fishhub-logo.png">
    <link rel="shortcut icon" type="image/png" href="/images/fishhub-logo.png">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .participant-card {
            transition: all 0.2s ease;
        }
        .participant-card:hover {
            background-color: #f9fafb;
        }
    </style>
</head>
<body class="bg-black min-h-screen">
    <!-- Navigation -->
    <nav class="bg-black text-white shadow-lg border-b border-yellow-400">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <a href="/" class="flex items-center">
                <img src="/images/fishhub-logo.png" alt="FishHub" class="h-10">
            </a>
            <div class="flex items-center space-x-4">
                <% if (locals.currentUser) { %>
                    <a href="/catches" class="hover:bg-gray-800 px-3 py-2 rounded transition text-white">My Catches</a>
                    <a href="/trips" class="hover:bg-gray-800 px-3 py-2 rounded transition text-white">Trips</a>
                    <a href="/fishing-spots" class="hover:bg-gray-800 px-3 py-2 rounded transition text-white">Find Spots</a>
                    <div class="relative">
                        <button id="userMenuButton" class="flex items-center space-x-2 focus:outline-none hover:bg-gray-800 px-3 py-2 rounded transition">
                            <img src="<%= currentUser.profilePicture || '/images/default-avatar.png' %>" 
                                 alt="Profile" 
                                 class="w-8 h-8 rounded-full border-2 border-yellow-400">
                            <span><%= currentUser.username %></span>
                            <i class="fas fa-chevron-down text-xs"></i>
                        </button>
                        <div id="userMenuDropdown" class="hidden absolute right-0 mt-2 w-48 bg-gray-900 rounded-lg shadow-xl py-2 z-10 border border-gray-700">
                            <a href="/users/<%= currentUser.id || currentUser._id %>" class="block px-4 py-2 text-white hover:bg-gray-800 transition">
                                <i class="fas fa-user mr-2 text-yellow-400"></i>My Profile
                            </a>
                            <a href="/settings" class="block px-4 py-2 text-white hover:bg-gray-800 transition">
                                <i class="fas fa-cog mr-2 text-yellow-400"></i>Settings
                            </a>
                            <form action="/auth/logout" method="POST" class="border-t border-gray-700 mt-1 pt-1">
                                <button type="submit" class="w-full text-left px-4 py-2 text-white hover:bg-gray-800 transition">
                                    <i class="fas fa-sign-out-alt mr-2 text-red-500"></i>Logout
                                </button>
                            </form>
                        </div>
                    </div>
                    <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            const menuButton = document.getElementById('userMenuButton');
                            const menuDropdown = document.getElementById('userMenuDropdown');
                            if (menuButton && menuDropdown) {
                                menuButton.addEventListener('click', function(e) {
                                    e.stopPropagation();
                                    menuDropdown.classList.toggle('hidden');
                                });
                                document.addEventListener('click', function(e) {
                                    if (!menuButton.contains(e.target) && !menuDropdown.contains(e.target)) {
                                        menuDropdown.classList.add('hidden');
                                    }
                                });
                            }
                        });
                    </script>
                <% } else { %>
                    <a href="/auth/register" class="hover:bg-gray-800 px-3 py-2 rounded transition text-white">Register</a>
                    <a href="/auth/login" class="bg-yellow-400 text-black hover:bg-yellow-300 px-4 py-2 rounded font-bold transition">Login</a>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8">
        <!-- Back Button -->
        <div class="mb-6">
            <a href="/trips" class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium transition">
                <i class="fas fa-arrow-left mr-2"></i> Back to All Trips
            </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Main Content -->
            <div class="lg:col-span-2">
                <!-- Trip Card -->
                <div class="bg-white rounded-xl shadow-lg overflow-hidden">
                    <!-- Image -->
                    <div class="relative h-96 bg-gradient-to-br from-green-400 to-teal-500">
                        <% if (trip.images && trip.images.length > 0) { %>
                            <img src="/<%= trip.images[0] %>" 
                                 alt="<%= trip.title %>" 
                                 class="w-full h-full object-cover">
                        <% } else { %>
                            <div class="flex items-center justify-center h-full">
                                <i class="fas fa-ship text-white text-8xl opacity-50"></i>
                            </div>
                        <% } %>
                        
                        <!-- Status Badge -->
                        <div class="absolute top-6 left-6">
                            <span class="inline-flex items-center px-4 py-2 rounded-full text-lg font-bold shadow-lg
                                <%= trip.status === 'upcoming' ? 'bg-blue-500 text-white' : 
                                   trip.status === 'in_progress' ? 'bg-yellow-500 text-white' : 
                                   trip.status === 'completed' ? 'bg-green-500 text-white' : 
                                   'bg-red-500 text-white' %>">
                                <i class="fas fa-circle text-xs mr-2"></i>
                                <%= trip.status.replace('_', ' ').replace(/\b\w/g, l => l.toUpperCase()) %>
                            </span>
                        </div>

                        <!-- Edit/Delete Actions (for creator only) -->
                        <% if (currentUser && trip.createdBy && String(trip.createdBy._id) === String(currentUser._id)) { %>
                            <div class="absolute top-6 right-6 flex space-x-2">
                                <a href="/trips/<%= trip._id %>/edit" 
                                   class="bg-white bg-opacity-95 hover:bg-opacity-100 text-blue-600 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition"
                                   title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form action="/trips/<%= trip._id %>?_method=DELETE" method="POST" class="inline">
                                    <button type="submit" 
                                            class="bg-white bg-opacity-95 hover:bg-opacity-100 text-red-600 w-10 h-10 rounded-full flex items-center justify-center shadow-lg transition"
                                            onclick="return confirm('Are you sure you want to delete this trip?')"
                                            title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        <% } %>
                    </div>

                    <!-- Content -->
                    <div class="p-8">
                        <!-- Title -->
                        <h1 class="text-3xl font-bold text-gray-900 mb-4"><%= trip.title %></h1>

                        <!-- Creator Info -->
                        <div class="flex items-center space-x-3 mb-6">
                            <img src="<%= trip.createdBy.profilePicture || '/images/default-avatar.png' %>" 
                                 alt="<%= trip.createdBy.username %>" 
                                 class="w-12 h-12 rounded-full border-2 border-gray-200">
                            <div>
                                <div class="flex items-center">
                                    <span class="text-sm text-gray-600 mr-2">Organized by</span>
                                    <a href="/users/<%= trip.createdBy._id %>" class="font-bold text-gray-900 hover:text-blue-600">
                                        <%= trip.createdBy.username %>
                                    </a>
                                    <i class="fas fa-crown text-yellow-500 ml-2" title="Trip Organizer"></i>
                                </div>
                                <time class="text-sm text-gray-500">
                                    Created <%= new Date(trip.createdAt).toLocaleDateString('en-US', { 
                                        month: 'short', 
                                        day: 'numeric',
                                        year: 'numeric'
                                    }) %>
                                </time>
                            </div>
                        </div>

                        <!-- Stats Grid -->
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
                            <div class="bg-blue-50 rounded-lg p-4 text-center">
                                <i class="far fa-calendar-alt text-2xl text-blue-600 mb-2"></i>
                                <div class="text-sm font-bold text-gray-900">
                                    <%= new Date(trip.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                </div>
                                <div class="text-xs text-gray-600">Start Date</div>
                            </div>
                            <div class="bg-green-50 rounded-lg p-4 text-center">
                                <i class="far fa-calendar-check text-2xl text-green-600 mb-2"></i>
                                <div class="text-sm font-bold text-gray-900">
                                    <%= new Date(trip.endDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                </div>
                                <div class="text-xs text-gray-600">End Date</div>
                            </div>
                            <div class="bg-purple-50 rounded-lg p-4 text-center">
                                <i class="fas fa-users text-2xl text-purple-600 mb-2"></i>
                                <div class="text-sm font-bold text-gray-900">
                                    <%= trip.participants.length %>/<%= trip.maxParticipants %>
                                </div>
                                <div class="text-xs text-gray-600">Participants</div>
                            </div>
                        </div>

                        <!-- Description -->
                        <% if (trip.description) { %>
                            <div class="mb-6">
                                <h3 class="text-lg font-bold text-gray-900 mb-2">Description</h3>
                                <p class="text-gray-700 leading-relaxed"><%= trip.description %></p>
                            </div>
                        <% } %>

                        <!-- Location -->
                        <div class="mb-6">
                            <h3 class="text-lg font-bold text-gray-900 mb-2">
                                <i class="fas fa-map-marker-alt text-red-500 mr-2"></i>Location
                            </h3>
                            <p class="text-gray-700"><%= trip.location.name %></p>
                        </div>

                        <!-- Tags -->
                        <% if (trip.tags && trip.tags.length > 0) { %>
                            <div class="mb-6">
                                <h3 class="text-lg font-bold text-gray-900 mb-2">Tags</h3>
                                <div class="flex flex-wrap gap-2">
                                    <% trip.tags.forEach(tag => { %>
                                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                                            <i class="fas fa-tag mr-1 text-xs"></i> <%= tag %>
                                        </span>
                                    <% }); %>
                                </div>
                            </div>
                        <% } %>

                        <!-- Join/Leave Button -->
                        <% if (currentUser) { %>
                            <% const isParticipant = trip.participants.some(p => String(p.user._id) === String(currentUser._id)); %>
                            <% const isCreator = String(trip.createdBy._id) === String(currentUser._id); %>
                            <% if (!isCreator && !isParticipant && trip.participants.length < trip.maxParticipants && trip.status === 'upcoming') { %>
                                <button id="joinTripBtn" 
                                        class="w-full bg-gradient-to-r from-green-600 to-teal-600 hover:from-green-700 hover:to-teal-700 text-white py-3 rounded-lg font-semibold transition transform hover:scale-105 shadow-lg">
                                    <i class="fas fa-user-plus mr-2"></i> Join This Trip
                                </button>
                            <% } else if (isParticipant && !isCreator) { %>
                                <div class="bg-green-50 border-2 border-green-200 rounded-lg p-4 text-center">
                                    <i class="fas fa-check-circle text-green-600 text-2xl mb-2"></i>
                                    <p class="text-green-800 font-semibold">You're participating in this trip!</p>
                                    <% const userParticipant = trip.participants.find(p => String(p.user._id) === String(currentUser._id)); %>
                                    <% if (userParticipant) { %>
                                        <p class="text-sm text-green-700 mt-1">
                                            Status: <span class="font-bold"><%= userParticipant.status.charAt(0).toUpperCase() + userParticipant.status.slice(1) %></span>
                                        </p>
                                    <% } %>
                                </div>
                            <% } else if (trip.participants.length >= trip.maxParticipants && !isParticipant) { %>
                                <div class="bg-red-50 border-2 border-red-200 rounded-lg p-4 text-center">
                                    <i class="fas fa-users-slash text-red-600 text-2xl mb-2"></i>
                                    <p class="text-red-800 font-semibold">This trip is full</p>
                                </div>
                            <% } %>
                        <% } else { %>
                            <a href="/auth/login" class="block w-full text-center bg-gradient-to-r from-green-600 to-teal-600 hover:from-green-700 hover:to-teal-700 text-white py-3 rounded-lg font-semibold transition transform hover:scale-105 shadow-lg">
                                <i class="fas fa-sign-in-alt mr-2"></i> Login to Join
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="lg:col-span-1">
                <!-- Participants List -->
                <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
                    <h3 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                        <i class="fas fa-users text-purple-600 mr-2"></i>
                        Participants (<%= trip.participants.length %>)
                    </h3>
                    
                    <div class="space-y-3">
                        <% trip.participants.forEach(participant => { %>
                            <div class="participant-card flex items-center justify-between p-3 rounded-lg border border-gray-100">
                                <div class="flex items-center space-x-3">
                                    <img src="<%= participant.user.profilePicture || '/images/default-avatar.png' %>" 
                                         alt="<%= participant.user.username %>" 
                                         class="w-10 h-10 rounded-full border-2 border-gray-200">
                                    <div>
                                        <a href="/users/<%= participant.user._id %>" class="font-semibold text-gray-900 hover:text-blue-600 block">
                                            <%= participant.user.username %>
                                            <% if (String(participant.user._id) === String(trip.createdBy._id)) { %>
                                                <i class="fas fa-crown text-yellow-500 ml-1 text-xs" title="Organizer"></i>
                                            <% } %>
                                        </a>
                                        <span class="text-xs px-2 py-0.5 rounded-full
                                            <%= participant.status === 'confirmed' ? 'bg-green-100 text-green-800' : 
                                               participant.status === 'pending' ? 'bg-yellow-100 text-yellow-800' : 
                                               'bg-red-100 text-red-800' %>">
                                            <%= participant.status.charAt(0).toUpperCase() + participant.status.slice(1) %>
                                        </span>
                                    </div>
                                </div>
                                
                                <!-- Participant Management (for trip creator) -->
                                <% if (currentUser && String(trip.createdBy._id) === String(currentUser._id) && String(participant.user._id) !== String(currentUser._id)) { %>
                                    <div class="flex space-x-1">
                                        <% if (participant.status !== 'confirmed') { %>
                                            <button class="update-status-btn text-green-600 hover:bg-green-50 p-2 rounded transition"
                                                    data-participant-id="<%= participant._id %>"
                                                    data-status="confirmed"
                                                    title="Confirm">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        <% } %>
                                        <% if (participant.status !== 'declined') { %>
                                            <button class="update-status-btn text-red-600 hover:bg-red-50 p-2 rounded transition"
                                                    data-participant-id="<%= participant._id %>"
                                                    data-status="declined"
                                                    title="Decline">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        <% } %>
                                    </div>
                                <% } %>
                            </div>
                        <% }); %>
                    </div>
                </div>

                <!-- Trip Info -->
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-xl font-bold text-gray-900 mb-4">
                        <i class="fas fa-info-circle text-blue-600 mr-2"></i>
                        Trip Info
                    </h3>
                    <div class="space-y-3 text-sm">
                        <div class="flex items-center justify-between">
                            <span class="text-gray-600">Visibility</span>
                            <span class="font-semibold <%= trip.isPublic ? 'text-green-600' : 'text-gray-600' %>">
                                <i class="fas <%= trip.isPublic ? 'fa-globe' : 'fa-lock' %> mr-1"></i>
                                <%= trip.isPublic ? 'Public' : 'Private' %>
                            </span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-600">Duration</span>
                            <span class="font-semibold text-gray-900">
                                <%= Math.ceil((new Date(trip.endDate) - new Date(trip.startDate)) / (1000 * 60 * 60 * 24)) %> days
                            </span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-gray-600">Spots Available</span>
                            <span class="font-semibold <%= trip.participants.length >= trip.maxParticipants ? 'text-red-600' : 'text-green-600' %>">
                                <%= trip.maxParticipants - trip.participants.length %> / <%= trip.maxParticipants %>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
    
    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 mt-12">
        <div class="container mx-auto px-4 py-8">
            <div class="text-center text-gray-600">
                <p class="text-sm">
                    &copy; <%= new Date().getFullYear() %> FishBook. Made with <i class="fas fa-heart text-red-500"></i> by anglers, for anglers.
                </p>
            </div>
        </div>
    </footer>

    <script>
        // Join Trip functionality
        const joinBtn = document.getElementById('joinTripBtn');
        if (joinBtn) {
            joinBtn.addEventListener('click', async function() {
                try {
                    const response = await fetch('/trips/<%= trip._id %>/join', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });

                    if (response.ok) {
                        window.location.reload();
                    } else {
                        const data = await response.json();
                        alert(data.msg || 'Failed to join trip');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('An error occurred while joining the trip');
                }
            });
        }

        // Update participant status (for trip creator)
        document.querySelectorAll('.update-status-btn').forEach(button => {
            button.addEventListener('click', async function() {
                const participantId = this.dataset.participantId;
                const status = this.dataset.status;
                
                try {
                    const response = await fetch('/trips/<%= trip._id %>/participants', {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ participantId, status })
                    });

                    if (response.ok) {
                        window.location.reload();
                    } else {
                        const data = await response.json();
                        alert(data.msg || 'Failed to update participant status');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('An error occurred while updating participant status');
                }
            });
        });
    </script>
</body>
</html>
