# MongoDB Connection
# For local development: mongodb://localhost:27017/fishbook
# For Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fishbook?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/fishbook

# Session Secret (generate a random string for production)
SESSION_SECRET=your_session_secret_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1h

# File upload configuration
MAX_FILE_UPLOAD=5 # in MB

# Weather API Configuration
# Note: Open Meteo API doesn't require an API key
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Server Port
PORT=3000

# Environment (development/production)
NODE_ENV=development
